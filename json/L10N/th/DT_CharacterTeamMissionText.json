  "fields": {
    "DUNGEON_GRASS": "\u0E16\u0E49\u0E33\u0E01\u0E25\u0E32\u0E07\u0E17\u0E38\u0E48\u0E07\u0E2B\u0E0D\u0E49\u0E32",
    "DUNGEON_FOREST": "\u0E40\u0E02\u0E15\u0E25\u0E31\u0E1A\u0E01\u0E25\u0E32\u0E07\u0E1E\u0E07\u0E44\u0E1E\u0E23",
    "DUNGEON_VOLCANO": "\u0E16\u0E49\u0E33\u0E41\u0E1C\u0E14\u0E40\u0E1C\u0E32\u0E01\u0E25\u0E32\u0E07\u0E20\u0E39\u0E40\u0E02\u0E32\u0E44\u0E1F",
    "DUNGEON_DESERT": "\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E2A\u0E16\u0E32\u0E19\u0E25\u0E31\u0E1A\u0E01\u0E25\u0E32\u0E07\u0E17\u0E30\u0E40\u0E25\u0E17\u0E23\u0E32\u0E22",
    "DUNGEON_SNOW": "\u0E16\u0E49\u0E33\u0E40\u0E22\u0E37\u0E2D\u0E01\u0E41\u0E02\u0E47\u0E07\u0E01\u0E25\u0E32\u0E07\u0E20\u0E39\u0E40\u0E02\u0E32\u0E2B\u0E34\u0E21\u0E30",
    "DUNGEON_SAKURAJIMA": "\u0E16\u0E49\u0E33\u0E1A\u0E38\u0E1B\u0E1C\u0E32\u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13\u0E1A\u0E19\u0E40\u0E01\u0E32\u0E30\u0E0B\u0E32\u0E01\u0E38\u0E23\u0E30",
    "DUNGEON_DARKISLAND": "\u0E16\u0E49\u0E33\u0E21\u0E32\u0E23\u0E41\u0E2B\u0E48\u0E07\u0E2A\u0E27\u0E23\u0E23\u0E04\u0E4C\u0E25\u0E48\u0E21",
    "DUNGEON_GRASSHARD": "\u0E42\u0E01\u0E14\u0E31\u0E07\u0E2A\u0E34\u0E19\u0E04\u0E49\u0E32\u0E40\u0E16\u0E37\u0E48\u0E2D\u0E19\u0E02\u0E2D\u0E07\u0E02\u0E1A\u0E27\u0E19\u0E01\u0E32\u0E23\u0E1E\u0E23\u0E32\u0E19\u0E40\u0E16\u0E37\u0E48\u0E2D\u0E19 \u0E40\u0E23\u0E19",
    "DUNGEON_FORESTHARD": "\u0E08\u0E38\u0E14\u0E02\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E40\u0E16\u0E37\u0E48\u0E2D\u0E19\u0E02\u0E2D\u0E07\u0E2D\u0E07\u0E04\u0E4C\u0E01\u0E23\u0E1C\u0E39\u0E49\u0E1E\u0E34\u0E17\u0E31\u0E01\u0E29\u0E4C\u0E1E\u0E32\u0E25",
    "DUNGEON_VOLCANOHARD": "\u0E15\u0E25\u0E32\u0E14\u0E21\u0E37\u0E14\u0E02\u0E2D\u0E07\u0E20\u0E32\u0E23\u0E14\u0E23\u0E40\u0E1E\u0E25\u0E34\u0E07\u0E19\u0E34\u0E23\u0E31\u0E19\u0E14\u0E23\u0E4C",
    "DUNGEON_DESERTHARD": "\u0E42\u0E23\u0E07\u0E07\u0E32\u0E19\u0E40\u0E16\u0E37\u0E48\u0E2D\u0E19\u0E02\u0E2D\u0E07\u0E2A\u0E31\u0E19\u0E15\u0E34\u0E1A\u0E32\u0E25",
    "DUNGEON_SNOWHARD": "\u0E28\u0E39\u0E19\u0E22\u0E4C\u0E27\u0E34\u0E08\u0E31\u0E22\u0E02\u0E2D\u0E07\u0E01\u0E2D\u0E07\u0E01\u0E33\u0E25\u0E31\u0E07\u0E27\u0E34\u0E08\u0E31\u0E22\u0E1E\u0E31\u0E19\u0E18\u0E38\u0E01\u0E23\u0E23\u0E21",
    "DUNGEON_SAKURAJIMAHARD": "\u0E10\u0E32\u0E19\u0E25\u0E31\u0E1A\u0E02\u0E2D\u0E07\u0E01\u0E25\u0E38\u0E48\u0E21\u0E1A\u0E38\u0E1B\u0E1C\u0E32\u0E08\u0E31\u0E19\u0E17\u0E23\u0E32",
    "DUNGEON_DARKISLANDHARD": "\u0E42\u0E1A\u0E23\u0E32\u0E13\u0E2A\u0E16\u0E32\u0E19 \u0E13 \u0E2A\u0E27\u0E23\u0E23\u0E04\u0E4C\u0E25\u0E48\u0E21"
  }
