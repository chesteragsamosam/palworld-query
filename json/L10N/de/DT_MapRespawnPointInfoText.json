  "namespace": "DT_MapRespawnPointInfoText",
  "fields": {
    "SpawnPoint_1": "Kuppe eines kleinen H\u00FCgels.\r\nAufgrund der guten \u00DCbersichtlichkeit und der reichhaltigen\r\nRessourcen f\u00FCr Einsteiger zu empfehlen.",
    "SpawnPoint_1_Title": "Windstiegh\u00FCgel\u00A0\u2013 Ebene des Aufbruchs",
    "SpawnPoint_2": "Sandstrand am Meer.\r\nHier gibt es kaum B\u00E4ume, aber ordentlich viele Pals, besonders Wasserspezies.",
    "SpawnPoint_2_Title": "Windstiegh\u00FCgel\u00A0\u2013 K\u00FCste der fliegenden Fische",
    "SpawnPoint_3": "Eine abseits gelegene Insel.\r\nDank des nahegelegenen Vulkans ist das Klima angenehm mild.\r\nHier kann man allerlei Abenteuer erleben, und auch die Hauptinsel ist nicht weit.",
    "SpawnPoint_3_Title": "Windhauchinseln\u00A0\u2013 Felsenriff",
    "SpawnPoint_4": "Ein felsiger K\u00FCstenstreifen.\r\nHier gibt es durchschnittlich viele Ressourcen und Pals.\r\nDie Gegend ist etwas rau, bietet aber viel Platz.",
    "SpawnPoint_4_Title": "Windhauchinseln\u00A0\u2013 Strand der Schiffbr\u00FCchigen",
    "SpawnPoint_5": "Weit ab von der Hauptinsel, daher ist hier keine Menschenseele.\r\nDurch die n\u00F6rdliche Lage sind die Temperaturen niedriger.\r\nEs gibt nur wenige Rohstoffe und Pals, was das Leben erschwert.",
    "SpawnPoint_5_Title": "Vergessene Insel",
    "SpawnPoint_6": "Von den Schneegipfeln her weht ein kalter Wind \u00FCber diese Insel.\r\nBesonders nachts friert es einen bis in die Knochen,\r\nund sogar die Ureinwohner w\u00FCrden lieber woanders hinziehen.",
    "SpawnPoint_6_Title": "Eiswindinsel",
    "SpawnPoint_7": "Eine wilde Insel im Osten.\r\nIst ganz am Rande des Archipels und vollkommen unerschlossen.\r\nNichts f\u00FCr unge\u00FCbte Survivalisten.",
    "SpawnPoint_7_Title": "\u00D6stliche Wildnisinsel",
    "SpawnPoint_8": "Eine Insel mit weitl\u00E4ufigen Mooren.\r\nDank der ma\u00DFvollen Feuchtigkeit wachsen hier Beeren in H\u00FClle und F\u00FClle.\r\nAuch die Hauptinsel ist gut zu erreichen.",
    "SpawnPoint_8_Title": "Moorinsel",
