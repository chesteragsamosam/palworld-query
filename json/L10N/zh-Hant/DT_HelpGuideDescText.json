  "fields": {
    "Help_1": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u9375\u76E4\uFF09\r\n\r\n\u6ED1\u9F20 \u8996\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|W_ForHelp|/\u003E\u003CkeyGuideIcon id=|A_ForHelp|/\u003E\u003CkeyGuideIcon id=|S_ForHelp|/\u003E\u003CkeyGuideIcon id=|D_ForHelp|/\u003E \u79FB\u52D5\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|1|/\u003E \u53EC\u559A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|1|/\u003E \u6295\u64F2\u5E15\u9B6F\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|1|/\u003E \u5EFA\u7BC9\u9078\u55AE\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|1|/\u003E \u8DF3\u8E8D\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|1|/\u003E \u7784\u6E96\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|1|/\u003E \u653B\u64CA\r\n\u003CkeyGuideIcon id=|Coop| OverrideType=|1|/\u003E \u5925\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|Reload| OverrideType=|1|/\u003E \u91CD\u65B0\u88DD\u586B\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|1|/\u003E\u003CkeyGuideIcon id=|ChangeWeaponPrev| OverrideType=|1|/\u003E \u6B66\u5668\u5207\u63DB\r\n\u003CkeyGuideIcon id=|Crouch| OverrideType=|1|/\u003E \u4E0B\u8E72\r\n\u003CkeyGuideIcon id=|Rolling| OverrideType=|1|/\u003E \u7FFB\u6EFE\r\n\u003CkeyGuideIcon id=|Dash| OverrideType=|1|/\u003E \u885D\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|1|/\u003E \u6307\u793A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|1|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|1|/\u003E \u5207\u63DB\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|1|/\u003E \u5207\u63DB\u5E15\u9B6F\u7403",
    "Help_2": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u63A7\u5236\u5668\uFF09\r\n\u5DE6\u6416\u687F \u79FB\u52D5\r\n\u53F3\u6416\u687F \u8996\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|2|/\u003E \u53EC\u559A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|2|/\u003E \u6295\u64F2\u5E15\u9B6F\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|2|/\u003E \u5EFA\u7BC9\u9078\u55AE\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|2|/\u003E \u8DF3\u8E8D\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|2|/\u003E \u7784\u6E96\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|2|/\u003E \u653B\u64CA\r\n\u003CkeyGuideIcon id=|ReloadAndCoop| OverrideType=|2|/\u003E \u5925\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|2|/\u003E \u5207\u63DB\u6B66\u5668\r\n\u003CkeyGuideIcon id=|RollingAndCrouch| OverrideType=|2|/\u003E \u4E0B\u8E72/\u7FFB\u6EFE\r\n\u003CkeyGuideIcon id=|DashController| OverrideType=|2|/\u003E \u885D\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|2|/\u003E \u6307\u793A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|2|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|2|/\u003E \u5207\u63DB\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|2|/\u003E \u5207\u63DB\u5E15\u9B6F\u7403",
    "Help_3": "\u904A\u6232\u76EE\u6A19\r\n\r\n\u6253\u5012\u6240\u6709\u5730\u5340\u7684\u9AD8\u5854\u982D\u76EE\uFF0C\u6210\u70BA\u6700\u5F37\u7684\u5E15\u9B6F\u8A13\u7DF4\u5BB6\uFF01\r\n\u60F3\u7A69\u7D2E\u7A69\u6253\u5730\u5F37\u5316\u81EA\u5DF1\u7684\u64DA\u9EDE\u4E5F\u597D\uFF0C\u6536\u96C6\u6240\u6709\u5E15\u9B6F\u4E5F\u597D\uFF0C\r\n\u8981\u900F\u904E\u914D\u7A2E\u8207\u5F37\u5316\u4F86\u6253\u9020\u6700\u5F37\u7684\u5E15\u9B6F\u7576\u7136\u4E5F\u6C92\u554F\u984C\u3002\r\n\r\n\u8207\u5E15\u9B6F\u9F4A\u5FC3\u5354\u529B\uFF0C\u76E1\u60C5\u63A2\u7D22\u9019\u7247\u5EE3\u95CA\u7684\u5927\u5730\u5427\uFF01",
    "Help_4": "\u4E00\u958B\u59CB\u8A72\u505A\u4E9B\u4EC0\u9EBC\u597D\u5462\uFF1F\r\n\r\n\u5148\u64BF\u4E9B\u6389\u5728\u5730\u4E0A\u7684\u6A39\u679D\u8207\u5C0F\u77F3\u982D\uFF0C\u9019\u6A23\u5C31\u6709\u6728\u6750\u8207\u77F3\u982D\u7684\u4F86\u6E90\u4E86\u3002\r\n\u7A7A\u624B\u6BC6\u6253\u5927\u6A39\u8207\u5CA9\u77F3\u540C\u6A23\u4E5F\u80FD\u53D6\u5F97\u6728\u6750\u8207\u77F3\u982D\u3002\r\n\u5EFA\u9020\u5DE5\u4F5C\u53F0\u4E26\u88FD\u4F5C\u65A7\u982D\uFF0C\u5C31\u80FD\u63D0\u5347\u63A1\u96C6\u7684\u6548\u7387\u3002\r\n\r\n\u6536\u96C6\u5230\u4E00\u5B9A\u7D20\u6750\u4E26\u9078\u597D\u64DA\u9EDE\u4F4D\u7F6E\u5F8C\uFF0C\u5C31\u4F86\u5EFA\u9020\u300C\u5E15\u9B6F\u7D42\u7AEF\u300D\u5427\u3002\r\n\u300C\u5E15\u9B6F\u7D42\u7AEF\u300D\u6240\u5728\u7684\u5730\u65B9\u5C31\u662F\u4F60\u7684\u64DA\u9EDE\u3002\r\n\r\n\u63D0\u5347\u7B49\u7D1A\u5F8C\u5C31\u80FD\u88FD\u4F5C\u6B66\u5668\u8207\u300C\u5E15\u9B6F\u7403\u300D\uFF0C\u524A\u5F31\u5E15\u9B6F\u7684\u9AD4\u529B\u4E26\u6355\u6349\u7260\u5011\u3002\r\n\u5E15\u9B6F\u4E0D\u4F46\u80FD\u6210\u70BA\u6230\u529B\uFF0C\u4E5F\u80FD\u628A\u7260\u5011\u9001\u9032\u64DA\u9EDE\u7576\u505A\u52DE\u52D5\u529B\u3002\r\n\r\n\u9019\u500B\u4E16\u754C\u7684\u591C\u665A\u662F\u5F88\u5371\u96AA\u7684\u3002\u5225\u5FD8\u4E86\u88FD\u4F5C\u300C\u5E8A\u92EA\u300D\u4EE5\u53CA\u300C\u71DF\u706B\u300D\u6216\u300C\u706B\u70AC\u300D\uFF0C\u624D\u80FD\u5E73\u5B89\u5EA6\u904E\u7B2C\u4E00\u665A\u3002",
    "Help_5": "\u95DC\u65BC\u5E15\u9B6F\r\n\r\n\u6B64\u5730\u5340\u6709\u8A31\u591A\u4E0D\u53EF\u601D\u8B70\u7684\u751F\u7269\u68F2\u606F\uFF0C\u7D71\u7A31\u70BA\u300C\u5E15\u9B6F\u300D\u3002\r\n\u7528\u5E15\u9B6F\u7403\u6355\u6349\u7260\u5011\uFF0C\u5C31\u80FD\u628A\u7260\u5011\u8B8A\u6210\u5925\u4F34\uFF0C\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|ThrowPal|/\u003E\u5C31\u80FD\u628A\u968A\u4F0D\u88E1\u7684\u5E15\u9B6F\u5F9E\u5E15\u9B6F\u7403\u88E1\u653E\u51FA\u4F86\u3002\r\n\r\n\u53EF\u4EE5\u5E36\u5728\u8EAB\u4E0A\u7684\u5E15\u9B6F\u6700\u591A5\u96BB\uFF0C\u8D85\u904E\u4E0A\u9650\u5F8C\uFF0C\u6355\u6349\u5230\u7684\u5E15\u9B6F\u6703\u88AB\u81EA\u52D5\u50B3\u9001\u81F3\u5E15\u9B6F\u7D42\u7AEF\uFF0C\r\n\u53EA\u8981\u5EFA\u9020\u5E15\u9B6F\u7D42\u7AEF\u5C31\u80FD\u628A\u7260\u5011\u653E\u51FA\u4F86\u3002",
    "Help_6": "HUD\r\n\r\n\u5DE6\u4E0B\u65B9\u986F\u793A\u7684\u662F\u968A\u4F0D\u88E1\u7684\u5E15\u9B6F\u53CA\u73A9\u5BB6\u7684\u751F\u547D\u503C\u8207\u98FD\u8DB3\u5EA6\u3002\r\n\u8A72\u8CC7\u8A0A\u53F3\u5074\u70BA\u76EE\u524D\u6C23\u6EAB\uFF0C\u5728\u9AD8\u6EAB\uFF0F\u4F4E\u6EAB\u74B0\u5883\u4E0B\u5C07\u6703\u53D7\u5230\u50B7\u5BB3\u3002\r\n\u53F3\u4E0B\u65B9\u986F\u793A\u7684\u5247\u662F\u76EE\u524D\u88DD\u5099\u7684\u5E15\u9B6F\u7403\u8207\u6B66\u5668\uFF0C\u4EE5\u53CA\u5176\u5269\u9918\u5B50\u5F48\u6578\u91CF\u3002",
    "Help_7": "\u5982\u4F55\u53D6\u5F97\u9053\u5177\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|Interact_1|/\u003E\u5373\u53EF\u64BF\u8D77\u6389\u5728\u5730\u4E0A\u7684\u9053\u5177\u3002\r\n\u7528\u65A7\u982D\u3001\u5341\u5B57\u93AC\u7834\u58DE\u6A39\u6728\u8207\u5CA9\u77F3\u7B49\u4E5F\u80FD\u53D6\u5F97\u7D20\u6750\u3002\r\n\u6253\u5012\u5E15\u9B6F\u6642\u4E5F\u80FD\u53D6\u5F97\u5E15\u9B6F\u6389\u843D\u7684\u9053\u5177\u3002",
    "Help_8": "\u5EFA\u9020\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|OpenConstructionMenu|/\u003E\u5373\u53EF\u958B\u555F\u5EFA\u7BC9\u9078\u55AE\u9032\u884C\u5EFA\u9020\u3002\r\n\u65BC\u5EFA\u7BC9\u9078\u55AE\u9078\u64C7\u4E26\u6C7A\u5B9A\u5EFA\u9020\u5730\u9EDE\u5F8C\uFF0C\u5728\u8A72\u5730\u9EDE\u9577\u6309\u003CkeyGuideIcon id=|Interact_1|/\u003E\u57F7\u884C\u4F5C\u696D\u5373\u53EF\u5B8C\u6210\u5EFA\u9020\u3002\r\n\u82E5\u968A\u4F0D\u6216\u64DA\u9EDE\u88E1\u6709\u5E15\u9B6F\uFF0C\u4E5F\u80FD\u627E\u7260\u5011\u4F86\u5354\u52A9\u5EFA\u9020\u3002",
    "Help_9": "\u88FD\u4F5C\r\n\r\n\u5EFA\u9020\u5DE5\u4F5C\u53F0\u7B49\uFF0C\u5373\u53EF\u5229\u7528\u5176\u529F\u80FD\u4F86\u88FD\u4F5C\u9053\u5177\u3002\r\n\u73A9\u5BB6\u53EF\u4F7F\u7528\u79D1\u6280\u9EDE\u4F86\u89E3\u9396\u65B0\u7684\u914D\u65B9\u6216\u5EFA\u9020\u5176\u4ED6\u5DE5\u4F5C\u8A2D\u65BD\uFF0C\r\n\u5982\u6B64\u4FBF\u80FD\u7FD2\u5F97\u65B0\u9053\u5177\u7684\u88FD\u4F5C\u65B9\u6CD5\u3002",
    "Help_10": "\u79D1\u6280\r\n\r\n\u958B\u555F\u9078\u55AE\u4E2D\u7684\u300C\u79D1\u6280\u300D\u5206\u9801\u4E26\u4F7F\u7528\u79D1\u6280\u9EDE\uFF0C\r\n\u5C31\u80FD\u89E3\u9396\u65B0\u7684\u5EFA\u7BC9\u6216\u9053\u5177\u914D\u65B9\u3002\r\n\u5347\u7D1A\u6216\u89E3\u9396\u5DE8\u9DF2\u4E4B\u50CF\u7B49\u4FBF\u53EF\u7372\u5F97\u79D1\u6280\u9EDE\u3002",
    "Help_11": "\u53E4\u4EE3\u79D1\u6280\r\n\r\n\u6253\u5012\u5F37\u5927\u7684\u6575\u4EBA\u5C07\u53EF\u7372\u5F97\u53E4\u4EE3\u79D1\u6280\u9EDE\uFF0C\r\n\u4F7F\u7528\u5B83\u4FBF\u53EF\u89E3\u9396\u53E4\u4EE3\u79D1\u6280\u3002\r\n\r\n\u53E4\u4EE3\u79D1\u6280\u662F\u5DF2\u6D88\u4EA1\u7684\u6587\u660E\u767C\u5C55\u51FA\u7684\u5148\u9032\u6280\u8853\uFF0C\r\n\u5176\u6548\u679C\u901A\u5E38\u65E2\u7368\u7279\u4E14\u5F37\u5927\u3002",
    "Help_12": "\u7B49\u7D1A\r\n\r\n\u73A9\u5BB6\u8207\u5E15\u9B6F\u7372\u5F97\u4E00\u5B9A\u7D93\u9A57\u503C\u5F8C\uFF0C\u7B49\u7D1A\u4FBF\u6703\u63D0\u5347\u3002\r\n\u8A0E\u4F10\u6216\u6355\u7372\u5E15\u9B6F\u7686\u53EF\u7372\u5F97\u7D93\u9A57\u503C\u3002\r\n\u6B64\u5916\uFF0C\u5EFA\u9020\u548C\u88FD\u4F5C\u6642\u4E5F\u80FD\u6839\u64DA\u5DE5\u4F5C\u91CF\u7372\u5F97\u7D93\u9A57\u3002\r\n\r\n\u73A9\u5BB6\u7121\u6CD5\u8B93\u7B49\u7D1A\u9AD8\u65BC\u81EA\u5DF1\u7684\u5E15\u9B6F\u807D\u8A71\uFF0C\r\n\u6B64\u6642\u7B49\u7D1A\u540C\u6B65\u6A5F\u5236\u6703\u751F\u6548\uFF0C\u4F7F\u7260\u7684\u80FD\u529B\u964D\u4F4E\u81F3\u8207\u73A9\u5BB6\u76F8\u540C\u7B49\u7D1A\u3002",
    "Help_13": "\u5F37\u5316\u73A9\u5BB6\u80FD\u529B\u503C\r\n\r\n\u6253\u958B\u9078\u55AE\u300C\u7269\u54C1\u6B04\u300D\u5206\u9801\u4E26\u5206\u914D\u5C6C\u6027\u9EDE\uFF0C\r\n\u5373\u53EF\u63D0\u5347\u73A9\u5BB6\u672C\u8EAB\u7684\u5404\u9805\u6578\u503C\u3002\r\n\u63D0\u5347\u73A9\u5BB6\u7684\u7B49\u7D1A\u4FBF\u53EF\u7372\u5F97\u5C6C\u6027\u9EDE\u3002",
    "Help_14": "\u64DA\u9EDE\r\n\r\n\u5EFA\u9020\u5E15\u9B6F\u7D42\u7AEF\u5F8C\uFF0C\u7D42\u7AEF\u5468\u908A\u5340\u57DF\u4FBF\u6703\u88AB\u8A8D\u5B9A\u70BA\u64DA\u9EDE\u3002\r\n\u5229\u7528\u5E15\u9B6F\u7D42\u7AEF\u7684\u529F\u80FD\u5373\u53EF\u5C07\u5E15\u9B6F\u53EC\u559A\u5230\u64DA\u9EDE\u5167\uFF0C\r\n\u800C\u5E15\u9B6F\u4F86\u5230\u64DA\u9EDE\u5F8C\uFF0C\u4FBF\u6703\u4F9D\u7167\u81EA\u5DF1\u7684\u5DE5\u4F5C\u9069\u61C9\u6027\u4E3B\u52D5\u57F7\u884C\u5DE5\u4F5C\u3002\r\n\r\n\u5728\u64DA\u9EDE\u5167\u5EFA\u9020\u5EFA\u7BC9\uFF0C\u5373\u53EF\u8B93\u5E15\u9B6F\u5354\u52A9\u5DE5\u4F5C\u3002\r\n\u4F46\u4F4D\u65BC\u64DA\u9EDE\u5167\u7684\u5E15\u9B6F\u4E5F\u5C07\u9762\u81E8\u5916\u6575\u7684\u5A01\u8105\uFF0C\u4E0D\u80FD\u6389\u4EE5\u8F15\u5FC3\u3002",
    "Help_15": "\u5E15\u9B6F\u7D42\u7AEF\r\n\r\n\u5E15\u9B6F\u7D42\u7AEF\u5468\u908A\u7684\u4E00\u5B9A\u7BC4\u570D\u5C07\u6210\u70BA\u4F60\u76EE\u524D\u516C\u6703\u7684\u64DA\u9EDE\u9818\u5730\uFF0C\u4F4D\u65BC\u9818\u5730\u4E0A\u7684\u5EFA\u7BC9\u4E5F\u5C07\u6210\u70BA\u8A72\u516C\u6703\u4E4B\u6240\u6709\u7269\u3002\r\n\u5229\u7528\u5E15\u9B6F\u7D42\u7AEF\u7684\u529F\u80FD\u5373\u53EF\u78BA\u8A8D\u300C\u4EFB\u52D9\u300D\u5167\u5BB9\uFF0C\u5B8C\u6210\u4EFB\u52D9\u4FBF\u80FD\u8B93\u516C\u6703\u64DA\u9EDE\u66F4\u9032\u4E00\u6B65\u767C\u5C55\uFF0C\u4E26\u589E\u52A0\u53EF\u53EC\u559A\u81F3\u64DA\u9EDE\u7684\u5E15\u9B6F\u6578\u91CF\u3002\r\n\r\n\u5C07\u5E15\u9B6F\u653E\u5165\u5E15\u9B6F\u7D42\u7AEF\u5167\uFF0C\u5C31\u80FD\u8B93\u7260\u5011\u4F11\u606F\u4E26\u56DE\u5FA9\u751F\u547D\u503C\u3002\r\n\u6B64\u56DE\u5FA9\u529F\u80FD\u5C0D\u9677\u5165\u7015\u6B7B\u72C0\u6CC1\u7684\u5E15\u9B6F\u540C\u6A23\u6709\u6548\u3002\r\n\r\n\u5E15\u9B6F\u7D42\u7AEF\u9644\u6709\u5FEB\u901F\u50B3\u9001\u529F\u80FD\uFF0C\u53EF\u4EE5\u8B93\u73A9\u5BB6\u77AC\u9593\u79FB\u52D5\u81F3\u65C5\u9014\u4E2D\u89E3\u9396\u7684\u5DE8\u9DF2\u4E4B\u50CF\u6240\u5728\u5730\u3002\r\n\u203B\u9700\u65BC\u4E16\u754C\u8A2D\u5B9A\u4E2D\u555F\u7528\u5FEB\u901F\u50B3\u9001\uFF0C\u624D\u80FD\u4F7F\u7528\u5FEB\u901F\u50B3\u9001\u529F\u80FD\u3002",
    "Help_16": "\u6355\u7372\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|ThrowObject|/\u003E\u5373\u53EF\u4E1F\u51FA\u5E15\u9B6F\u7403\uFF0C\u4E1F\u4E2D\u5E15\u9B6F\u4FBF\u80FD\u5617\u8A66\u6355\u6349\u5E15\u9B6F\u3002\r\n\u751F\u547D\u503C\u6709\u6240\u964D\u4F4E\u3001\u8655\u65BC\u7570\u5E38\u72C0\u614B\u6216\u843D\u5165\u9677\u9631\u4E4B\u4E2D\u7684\u5E15\u9B6F\u8F03\u5BB9\u6613\u6355\u7372\u3002\r\n\u53E6\u5916\u4E5F\u53EF\u8D81\u5E15\u9B6F\u4E0D\u6CE8\u610F\u6642\u5F9E\u5F8C\u65B9\u4E1F\u51FA\u5E15\u9B6F\u7403\uFF0C\u63D0\u9AD8\u6210\u529F\u6355\u7372\u7684\u6A5F\u7387\u3002\r\n\u88FD\u4F5C\u66F4\u5F37\u7684\u5E15\u9B6F\u7403\uFF0C\u5C31\u80FD\u6355\u6349\u6709\u4E00\u5B9A\u5F37\u5EA6\u7684\u5E15\u9B6F\u3002",
    "Help_17": "\u968A\u4F0D\u4E2D\u7684\u5E15\u9B6F\r\n\r\n\u4F60\u53EF\u4EE5\u540C\u6642\u651C\u5E36\u7684\u5E15\u9B6F\u6578\u91CF\u6700\u591A\u70BA5\u96BB\uFF0C\u5982\u679C\u6355\u7372\u4E866\u96BB\u6216\u66F4\u591A\uFF0C\u591A\u9918\u7684\u5E15\u9B6F\u5C07\u6703\u88AB\u81EA\u52D5\u50B3\u9001\u81F3\u5E15\u9B6F\u7D42\u7AEF\u3002\r\n\u4F60\u651C\u5E36\u7684\u9019\u6700\u591A5\u96BB\u5E15\u9B6F\u5C31\u7D44\u6210\u4E86\u4F60\u7684\u968A\u4F0D\u3002\r\n\r\n\u6253\u958B\u9078\u55AE\u5F8C\u5373\u53EF\u6253\u958B\u300C\u968A\u4F0D\u300D\u5206\u9801\uFF0C\r\n\u78BA\u8A8D\u968A\u4F0D\u5167\u5E15\u9B6F\u7684\u751F\u547D\u503C\u53CA\u98FD\u8DB3\u5EA6\u7B49\u6578\u503C\u3002\r\n\u6B64\u5916\uFF0C\u9084\u53EF\u4EE5\u67E5\u770B\u5E15\u9B6F\u76EE\u524D\u5B78\u6703\u7684\u6280\u80FD\uFF0C\r\n\u4E26\u66FF\u63DB\u5E15\u9B6F\u5DF2\u5B78\u6703\u7684\u4E3B\u52D5\u6280\u80FD\u7B49\u3002",
    "Help_18": "\u98FD\u8DB3\u5EA6\r\n\r\n\u73A9\u5BB6\u8207\u5E15\u9B6F\u7684\u6D3B\u52D5\u6703\u5C0E\u81F4\u98FD\u8DB3\u5EA6\u4E0B\u964D\u3002\r\n\u98FD\u8DB3\u5EA6\u964D\u4F4E\u6703\u5C0E\u81F4\u5404\u9805\u6578\u503C\u4E0B\u964D\u7B49\u8CA0\u9762\u5F71\u97FF\u3002\r\n\r\n\u958B\u555F\u7269\u54C1\u6B04\u4F7F\u7528\u98DF\u7269\u985E\u9053\u5177\uFF0C\r\n\u4FBF\u53EF\u56DE\u5FA9\u73A9\u5BB6\u6216\u5E15\u9B6F\u7684\u98FD\u8DB3\u5EA6\u3002",
    "Help_19": "SAN\u503C\r\n\r\n\u5728\u64DA\u9EDE\u5DE5\u4F5C\u6703\u5C0E\u81F4\u5E15\u9B6F\u7684SAN\u503C\u4E0B\u964D\u3002\r\nSAN\u503C\u964D\u4F4E\u6703\u5C0E\u81F4\u5E15\u9B6F\u5077\u61F6\u6216\u751F\u75C5\u3002\r\n\u4E14\u98FD\u8DB3\u5EA6\u964D\u4F4E\u6642\uFF0CSAN\u503C\u4E0B\u964D\u7684\u901F\u5EA6\u6703\u66F4\u5FEB\u3002\r\n\u7D66\u4E88\u7F8E\u5473\u7684\u9910\u9EDE\u6216\u8B93\u7260\u5011\u5230\u6EAB\u6CC9\u4F11\u990A\uFF0C\u5373\u53EF\u56DE\u5FA9\u5E15\u9B6F\u7684SAN\u5024\u3002",
    "Help_20": "\u5925\u4F34\u6280\u80FD\r\n\r\n\u5E15\u9B6F\u7684\u56FA\u6709\u80FD\u529B\uFF0C\u4F9D\u5176\u7A2E\u65CF\u6709\u6240\u4E0D\u540C\u3002\r\n\u5925\u4F34\u6280\u80FD\u6548\u679C\u5305\u542B\u53EF\u8B93\u73A9\u5BB6\u9A0E\u4E58\u5E15\u9B6F\uFF0C\u6216\u8B93\u5E15\u9B6F\u80FD\u5920\u6301\u69CD\u5C04\u64CA\u7B49\u3002\r\n\r\n\u90E8\u5206\u5E15\u9B6F\u9700\u6709\u300C\u5E15\u9B6F\u88DD\u5099\u300D\u624D\u80FD\u89E3\u9396\u5925\u4F34\u6280\u80FD\uFF0C\u800C\u5E15\u9B6F\u88DD\u5099\u53EF\u65BC\u5E15\u9B6F\u88DD\u5099\u5DE5\u4F5C\u53F0\u88FD\u4F5C\u3002\r\n\r\n\u4EA6\u6709\u90E8\u5206\u5E15\u9B6F\u4F4D\u65BC\u968A\u4F0D\u5167\u4FBF\u80FD\u767C\u52D5\u5925\u4F34\u6280\u80FD\u7684\u6548\u679C\u3002\u958B\u555F\u968A\u4F0D\u756B\u9762\u5373\u53EF\u67E5\u770B\u5925\u4F34\u6280\u80FD\u7684\u6548\u679C\u3002",
    "Help_21": "\u5E15\u9B6F\u5716\u9451\r\n\r\n\u53EF\u900F\u904E\u9078\u55AE\u958B\u555F\u5E15\u9B6F\u5716\u9451\u3002\r\n\u5716\u9451\u6703\u81EA\u52D5\u8A18\u9304\u66FE\u76EE\u64CA\u6216\u6355\u7372\u7684\u5E15\u9B6F\u8CC7\u8A0A\uFF0C\r\n\u67E5\u95B1\u5716\u9451\u5373\u53EF\u78BA\u8A8D\u5176\u68F2\u606F\u5730\u7B49\u8CC7\u8A0A\u3002",
    "Help_22": "\u5716\u9451\u734E\u52F5\r\n\r\n\u6355\u7372\u65B0\u54C1\u7A2E\u7684\u5E15\u9B6F\u6642\uFF0C\u73A9\u5BB6\u5C07\u80FD\u7372\u5F97\u7D93\u9A57\u503C\u734E\u52F5\u3002\r\n\u4E14\u5728\u6293\u523012\u96BB\u8A72\u7A2E\u65CF\u5E15\u9B6F\u524D\uFF0C\u6BCF\u6B21\u6355\u7372\u7686\u53EF\u7372\u5F97\u7D93\u9A57\u503C\u734E\u52F5\u3002",
    "Help_23": "\u516C\u6703\r\n\r\n\u63A5\u8FD1\u5176\u4ED6\u73A9\u5BB6\uFF0C\u5373\u53EF\u7533\u8ACB\u52A0\u5165\u5C0D\u65B9\u7684\u516C\u6703\u3002\r\n\u6B64\u5916\uFF0C\u958B\u555F\u9078\u55AE\u5F8C\u53EF\u9EDE\u9078\u516C\u6703\u5206\u9801\uFF0C\r\n\u8A72\u5206\u9801\u5167\u6703\u986F\u793A\u76EE\u524D\u516C\u6703\u7684\u8CC7\u8A0A\uFF0C\u4E26\u53EF\u67E5\u770B\u516C\u6703\u6210\u54E1\u7684\u72C0\u6CC1\u7B49\u3002\r\n\u540C\u4E00\u516C\u6703\u7684\u73A9\u5BB6\u5C07\u5171\u4EAB\u64DA\u9EDE\uFF0C\r\n\u4E26\u53EF\u81EA\u7531\u5171\u4EAB\u3001\u5206\u6D3E\u65BC\u64DA\u9EDE\u5167\u5DE5\u4F5C\u7684\u5E15\u9B6F\u3002",
    "Help_24": "\u5730\u5716\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|OpenWorldMap|/\u003E\u5373\u53EF\u958B\u555F\u5730\u5716\u3002\r\n\u5730\u5716\u4E0A\u6703\u6A19\u793A\u5404\u5340\u57DF\u4E4B\u8CC7\u8A0A\u7B49\u3002",
    "Help_25": "\u5DE8\u9DF2\u4E4B\u50CF\r\n\r\n\u8207\u4E4B\u4E92\u52D5\u5373\u53EF\u89E3\u9396\uFF0C\r\n\u4E26\u53EF\u5FEB\u901F\u50B3\u9001\u81F3\u5176\u4ED6\u5DE8\u9DF2\u4E4B\u50CF\u6216\u81EA\u5DF1\u7684\u5E15\u9B6F\u7D42\u7AEF\u7684\u6240\u5728\u5730\u3002\r\n\r\n\u89E3\u9396\u5DE8\u9DF2\u4E4B\u50CF\u6642\u4EA6\u53EF\u7372\u5F97\u79D1\u6280\u9EDE\u3002\r\n\u5DE8\u9DF2\u4E4B\u50CF\u904D\u5E03\u65BC\u5404\u5730\uFF0C\u5192\u96AA\u6642\u5225\u5FD8\u4E86\u627E\u627E\u5B83\u7684\u8E64\u8DE1\u3002\r\n\r\n\u203B\u9700\u65BC\u4E16\u754C\u8A2D\u5B9A\u4E2D\u555F\u7528\u5FEB\u901F\u50B3\u9001\uFF0C\u624D\u80FD\u4F7F\u7528\u5FEB\u901F\u50B3\u9001\u529F\u80FD\u3002",
    "Help_26": "\u74B0\u5F62\u9078\u55AE\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|PartnerPalInstructions|/\u003E\u9375\u5F8C\u5373\u53EF\u53EB\u51FA\u9019\u500B\u9078\u55AE\u3002\r\n\u900F\u904E\u6B64\u9078\u55AE\u53EF\u5C0D\u968A\u4F0D\u5167\u7684\u5E15\u9B6F\u4E0B\u9054\u4F5C\u6230\u547D\u4EE4\uFF0C\u6216\u9935\u98FC\u6599\u7D66\u968A\u4F0D\u5167\u7684\u5E15\u9B6F\u5403\u7B49\u3002",
    "Help_27": "\u95DC\u65BC\u591C\u665A\r\n\r\n\u591C\u665A\u6703\u96A8\u8457\u6642\u9593\u7684\u6D41\u901D\u5230\u4F86\uFF0C\u5C46\u6642\u56DB\u5468\u6703\u8B8A\u6697\u3001\u6C23\u6EAB\u4E0B\u964D\uFF0C\u591C\u884C\u6027\u7684\u5371\u96AA\u5E15\u9B6F\u4E5F\u6703\u958B\u59CB\u51FA\u6C92\u3002\r\n\u548C\u5927\u5BB6\u4E00\u8D77\u5F85\u5728\u5B89\u5168\u7684\u5730\u9EDE\u570D\u8457\u71DF\u706B\u53D6\u6696\uFF0C\u6216\u8005\u5EFA\u9020\u5E8A\u92EA\u4E00\u89BA\u7761\u5230\u5929\u4EAE\u6703\u662F\u6BD4\u8F03\u5B89\u5168\u7684\u505A\u6CD5\u3002",
    "Help_28": "\u9AD8\u5854\u982D\u76EE\r\n\r\n\u6BCF\u500B\u5340\u57DF\u90FD\u77D7\u7ACB\u8457\u4E00\u5EA7\u9AD8\u5854\uFF0C\u7531\u63A7\u5236\u8A72\u5730\u5340\u7684\u7D44\u7E54\u9996\u9818\u8CA0\u8CAC\u5B88\u885B\u3002\r\n\u4ED6\u5011\u901A\u5E38\u5C0D\u4F86\u81EA\u5CF6\u5916\u7684\u5E15\u9B6F\u8A13\u7DF4\u5BB6\u62B1\u6709\u6575\u610F\uFF0C\u4E00\u65E6\u9032\u5165\u5854\u5167\u4FBF\u6703\u7ACB\u5373\u6230\u9B25\u3002\r\n\u5854\u5167\u7684\u982D\u76EE\u6230\u6709\u6642\u9593\u9650\u5236\uFF0C\u672A\u80FD\u5728\u898F\u5B9A\u6642\u9593\u5167\u64CA\u6557\u6575\u4EBA\u5373\u7B97\u5931\u6557\u3002\r\n\u4F46\u53EA\u8981\u6C92\u6709\u5176\u4ED6\u4EBA\u6B63\u5728\u6311\u6230\uFF0C\u4FBF\u53EF\u4EE5\u7121\u9650\u6B21\u5617\u8A66\u3002",
    "Help_29": "\u72AF\u7F6A\r\n\r\n\u82E5\u653B\u64CA\u91CE\u5916\u6216\u6751\u5B50\u88E1\u7684\u5584\u826FNPC\uFF0C\u5C31\u6703\u88AB\u6AA2\u8209\u4E26\u5217\u70BA\u72AF\u7F6A\u5206\u5B50\u3002\r\n\u6B64\u5916\uFF0C\u8E0F\u9032\u7981\u6B62\u9032\u5165\u7684\u90E8\u5206\u5CF6\u5DBC\u4E5F\u6703\u8B93\u4F60\u88AB\u8996\u70BA\u72AF\u7F6A\u5206\u5B50\u3002\r\n\u72AF\u7F6A\u884C\u70BA\u4E00\u65E6\u88AB\u4EBA\u767C\u73FE\uFF0C\u5C31\u6703\u906D\u5E15\u6D1B\u65AF\u7FA4\u5CF6\u81EA\u885B\u968A\u901A\u7DDD\uFF0C\u8ACB\u52D9\u5FC5\u6CE8\u610F\u3002",
    "Help_30": "\u88DD\u5099\u7684\u8010\u4E45\u503C\r\n\r\n\u4F7F\u7528\u88DD\u5099\u6703\u4F7F\u5176\u8010\u4E45\u503C\u964D\u4F4E\uFF0C\u800C\u8010\u4E45\u503C\u6B78\u96F6\u6642\u88DD\u5099\u4FBF\u6703\u640D\u58DE\u3002\r\n\u65BC\u4FEE\u7406\u5DE5\u4F5C\u53F0\u4F7F\u7528\u7D20\u6750\u5373\u53EF\u4FEE\u7406\u8010\u4E45\u503C\u964D\u4F4E\u7684\u88DD\u5099\u3002",
    "Help_31": "\u9053\u5177\u7684\u8150\u58DE\u6A5F\u5236\r\n\r\n\u98DF\u7269\u7B49\u90E8\u5206\u9053\u5177\u6703\u96A8\u6642\u9593\u7D93\u904E\u800C\u8150\u58DE\uFF0C\u800C\u9053\u5177\u8150\u58DE\u5F8C\u4FBF\u6703\u6D88\u5931\u3002\r\n\u5C07\u9019\u985E\u9053\u5177\u653E\u9032\u4FDD\u51B7\u7BB1\u6216\u51B0\u7BB1\u7B49\u5373\u53EF\u6291\u5236\u8150\u58DE\u3002",
    "Help_32": "\u5C6C\u6027\r\n\r\n\u5E15\u9B6F\u53EF\u5206\u70BA\u4E0D\u540C\u5C6C\u6027\uFF0C\u6BCF\u7A2E\u5C6C\u6027\u5747\u6709\u5404\u81EA\u7684\u512A\u52E2\u5C6C\u6027\u8207\u5F31\u9EDE\u5C6C\u6027\u3002\r\n\u653B\u64CA\u512A\u52E2\u5C6C\u6027\u7684\u5E15\u9B6F\u53EF\u9020\u6210\u66F4\u591A\u50B7\u5BB3\uFF0C\u800C\u653B\u64CA\u5F31\u9EDE\u5C6C\u6027\u7684\u5E15\u9B6F\u9020\u6210\u7684\u50B7\u5BB3\u6703\u8F03\u5C11\u3002",
    "Help_33": "\u7570\u5E38\u72C0\u614B\r\n\r\n\u5E15\u9B6F\u8207\u73A9\u5BB6\u6703\u56E0\u5468\u906D\u74B0\u5883\u6216\u6280\u80FD\u6548\u679C\u800C\u9677\u5165\u7570\u5E38\u72C0\u614B\u3002\r\n\u7570\u5E38\u72C0\u614B\u53EF\u80FD\u6703\u4F7F\u79FB\u52D5\u901F\u5EA6\u6E1B\u7DE9\uFF0C\u6216\u5C0D\u5E15\u9B6F\u8207\u73A9\u5BB6\u9020\u6210\u6301\u7E8C\u50B7\u5BB3\u3002\r\n\u9677\u5165\u7570\u5E38\u72C0\u614B\u7684\u5E15\u9B6F\u8F03\u5BB9\u6613\u6355\u7372\u3002",
    "Help_34": "\u5E15\u9B6F\u86CB\r\n\r\n\u5728\u91CE\u5916\u63A2\u7D22\u6642\u6709\u6642\u80FD\u5920\u627E\u5230\u5E15\u9B6F\u86CB\u3002\r\n\u5C07\u5E15\u9B6F\u86CB\u7F6E\u65BC\u5E15\u9B6F\u86CB\u5B75\u5316\u5668\uFF0C\u5C31\u80FD\u4F7F\u4E4B\u5B75\u5316\u3002\r\n\u5C07\u5468\u906D\u74B0\u5883\u8ABF\u6574\u70BA\u9069\u5408\u8A72\u5E15\u9B6F\u86CB\u7684\u6EAB\u5EA6\uFF0C\u5C31\u80FD\u52A0\u5FEB\u5B75\u5316\u901F\u5EA6\u3002",
    "Help_35": "\u5E15\u9B6F\u914D\u7A2E\u7267\u5834\r\n\r\n\u5C07\u96CC\u6027\u8207\u96C4\u6027\u7684\u5E15\u9B6F\u5206\u6D3E\u81F3\u914D\u7A2E\u7267\u5834\uFF0C\u4E26\u5728\u7267\u5834\u5167\u653E\u7F6E\u86CB\u7CD5\uFF0C\r\n\u5C31\u6709\u6A5F\u6703\u7372\u5F97\u5E15\u9B6F\u86CB\u3002\r\n\u67D0\u4E9B\u7279\u6B8A\u7684\u5E15\u9B6F\u7D44\u5408\u5C07\u6703\u751F\u4E0B\u7279\u6B8A\u7684\u5E15\u9B6F\u86CB\u3002",
    "Help_36": "\u5E15\u9B6F\u968E\u7D1A\u8207\u6FC3\u7E2E\u6A5F\r\n\r\n\u6BCF\u96BB\u5E15\u9B6F\u7686\u6709\u5404\u81EA\u7684\u968E\u7D1A\uFF0C\u968E\u7D1A\u8D8A\u9AD8\uFF0C\u5176\u7D20\u8CEA\u4E5F\u8D8A\u9AD8\u3002\r\n\u4E14\u90E8\u5206\u5E15\u9B6F\u7684\u968E\u7D1A\u8D8A\u9AD8\uFF0C\u5176\u5925\u4F34\u6280\u80FD\u7684\u6548\u679C\u8D8A\u5F37\u3002\r\n\u73A9\u5BB6\u53EF\u900F\u904E\u6FC3\u7E2E\u6A5F\u8A2D\u65BD\u4F86\u63D0\u5347\u5E15\u9B6F\u7684\u968E\u7D1A\uFF0C\u4F46\u9700\u5148\u7528\u6FC3\u7E2E\u6A5F\u5C07\u5927\u91CF\u7684\u540C\u54C1\u7A2E\u5E15\u9B6F\u6FC3\u7E2E\u6210\u7CBE\u83EF\u3002",
    "Help_37": "\u7FE0\u8449\u9F20\u96D5\u50CF\r\n\r\n\u5C07\u5728\u91CE\u5916\u627E\u5230\u7684\u7FE0\u8449\u9F20\u96D5\u50CF\u737B\u7D66\u529B\u91CF\u4E4B\u50CF\uFF0C\r\n\u4FBF\u80FD\u5F37\u5316\u73A9\u5BB6\u7684\u529B\u91CF\uFF0C\u63D0\u9AD8\u73A9\u5BB6\u6355\u7372\u5E15\u9B6F\u7684\u80FD\u529B\u3002",
    "Help_38": "\u5E15\u9B6F\u4E4B\u9B42\r\n\r\n\u5C07\u5F9E\u5BF6\u7BB1\u7B49\u627E\u5230\u7684\u5E15\u9B6F\u4E4B\u9B42\u737B\u7D66\u529B\u91CF\u4E4B\u50CF\uFF0C\r\n\u4FBF\u80FD\u5F37\u5316\u5E15\u9B6F\u7684\u529B\u91CF\uFF0C\u63D0\u9AD8\u5E15\u9B6F\u7684\u80FD\u529B\u503C\u3002",
    "Help_39": "\u5E15\u9B6F\u7684\u4E9E\u7A2E\r\n\r\n\u6839\u64DA\u89C0\u5BDF\u7D50\u679C\uFF0C\u90E8\u5206\u5E15\u9B6F\u70BA\u4E86\u9069\u61C9\u68F2\u606F\u74B0\u5883\u800C\u767C\u5C55\u51FA\u4E0D\u540C\u7684\u5F62\u614B\uFF0C\u9019\u985E\u5F62\u614B\u7A31\u70BA\u300C\u4E9E\u7A2E\u300D\u3002\r\n\u4E9E\u7A2E\u64C1\u6709\u8207\u539F\u7A2E\u4E0D\u540C\u7684\u5C6C\u6027\uFF0C\u4E14\u5176\u7D20\u8CEA\u4E5F\u6703\u7A0D\u5FAE\u9AD8\u51FA\u4E00\u4E9B\u3002\r\n\r\n\u6B64\u5916\uFF0C\u70BA\u5E15\u9B6F\u914D\u7A2E\u6642\uFF0C\u90E8\u5206\u5E15\u9B6F\u7D44\u5408\u6709\u53EF\u80FD\u6703\u751F\u51FA\u4E9E\u7A2E\u3002\r\n\r\n\u4E9E\u7A2E\u7684\u5716\u9451\u734E\u52F5\u8207\u539F\u7A2E\u5206\u958B\u8A08\u7B97\uFF0C\u56E0\u6B64\u6355\u7372\u524D12\u96BB\u4E9E\u7A2E\u6642\u4EA6\u53EF\u7372\u5F97\u66F4\u591A\u7D93\u9A57\u503C\u3002",
    "Help_40": "\u5E78\u904B\u5E15\u9B6F\r\n\r\n\u6709\u6642\u80FD\u5728\u91CE\u5916\u767C\u73FE\u7A31\u70BA\u300C\u5E78\u904B\u5E15\u9B6F\u300D\u7684\u7F55\u898B\u5E15\u9B6F\u3002\r\n\u9019\u7A2E\u5E15\u9B6F\u7684\u7279\u5FB5\u662F\u9AD4\u578B\u8F03\u5927\uFF0C\u4E14\u8EAB\u9AD4\u6703\u6563\u767C\u5149\u8292\u3002\r\n\u7260\u5011\u64C1\u6709\u7279\u6B8A\u7684\u88AB\u52D5\u6280\u80FD\u8207\u4E3B\u52D5\u6280\u80FD\uFF0C\u4E14\u80FD\u529B\u503C\u901A\u5E38\u4E5F\u8F03\u9AD8\u3002",
    "Help_40_2": "\u6355\u98DF\u8005\u5E15\u9B6F\r\n\r\n\u6709\u6642\u80FD\u5728\u91CE\u5916\u767C\u73FE\u7A31\u70BA\u300C\u6355\u98DF\u8005\u5E15\u9B6F\u300D\u7684\u5147\u731B\u5E15\u9B6F\u3002\r\n\u9019\u7A2E\u5E15\u9B6F\u7684\u7279\u5FB5\u662F\u9AD4\u578B\u5DE8\u5927\uFF0C\u5168\u8EAB\u6563\u767C\u8457\u6697\u7D05\u8272\u7684\u6C23\u606F\uFF0C\u6027\u60C5\u6975\u70BA\u5147\u731B\u3002\r\n\u56E0\u70BA\u53D7\u5230\u9ED1\u6697\u6C23\u5834\u7684\u4FDD\u8B77\uFF0C\u6355\u98DF\u8005\u5E15\u9B6F\u7121\u6CD5\u88AB\u5E15\u9B6F\u7403\u6355\u6349\u3002\r\n\u5728\u9032\u884C\u6311\u6230\u4E4B\u524D\uFF0C\u8ACB\u78BA\u4FDD\u4F60\u6709\u8DB3\u5920\u7684\u6230\u529B\u3002",
    "Help_41": "\u6B7B\u4EA1\u61F2\u7F70\u6A5F\u5236\r\n\r\n\u73A9\u5BB6\u6B7B\u4EA1\u6642\uFF0C\u6301\u6709\u7684\u9053\u5177\u8207\u5E15\u9B6F\u5C07\u6703\u6389\u843D\u5728\u6B7B\u4EA1\u5730\u9EDE\u3002\r\n\u5FA9\u6D3B\u5F8C\u518D\u6B21\u56DE\u5230\u8A72\u5730\u5373\u53EF\u64BF\u56DE\u6389\u843D\u7269\u3002\r\n\u6B64\u5916\uFF0C\u5728\u4E0A\u7A7A\u4E5F\u80FD\u89F8\u6478\u6B7B\u4EA1\u6642\u7522\u751F\u7684\u5149\u67F1\uFF0C\u53EF\u4EE5\u900F\u904E\u9019\u7A2E\u65B9\u5F0F\u56DE\u6536\u5E15\u9B6F\u548C\u9053\u5177\u3002\r\n\r\n\u203B\u53EF\u65BC\u4E16\u754C\u8A2D\u5B9A\u4E2D\u8ABF\u6574\u61F2\u7F70\u6A5F\u5236\u7684\u6709\u7121\u53CA\u5176\u5167\u5BB9\u3002",
    "Help_42": "\u7AF6\u6280\u5834\r\n\r\n\u7AF6\u6280\u5834\u662F\u6C99\u6F20\u5730\u5340\u67D0\u5EA7\u5C0F\u5CF6\u4E0A\u7684\u8A2D\u65BD\u3002\r\n\u5728\u9019\u88E1\u53EF\u4EE5\u8207\u81EA\u5DF1\u7CBE\u5FC3\u57F9\u80B2\u7684\u5E15\u9B6F\u4E26\u80A9\u4F5C\u6230\uFF0C\u8DDF\u540C\u4E00\u4E16\u754C\u5167\u7684\u5176\u4ED6\u5E15\u9B6F\u8A13\u7DF4\u5BB6\u4E00\u8F03\u9AD8\u4E0B\u3002\r\n\u9664\u6B64\u4E4B\u5916\uFF0C\u4E5F\u53EF\u4EE5\u548CNPC\u9032\u884C\u5C0D\u6230\u3002\u7279\u5225\u662F\u5927\u5E2B\u7D1A\u7684NPC\uFF0C\u4ED6\u5011\u7684\u5BE6\u529B\u6975\u70BA\u5F37\u5927\u3002\r\n\r\n\u5F9E\u968A\u4F0D\u5167\u76845\u96BB\u5E15\u9B6F\u4E2D\uFF0C\u9078\u51FA1\u96BB\u4F5C\u70BA\u642D\u6A94\u7684\u4E3B\u529B\u5E15\u9B6F\u548C\u53E6\u59162\u96BB\u8F14\u52A9\u5E15\u9B6F\u5171\u540C\u53C3\u6230\u3002\r\n\u5C07\u5C0D\u624B\u7684\u5E15\u9B6F\u8A13\u7DF4\u5BB6\u64CA\u6557\uFF0C\u6216\u8005\u5C07\u5C0D\u624B\u7684\u5E15\u9B6F\u5168\u90E8\u6253\u5012\u5373\u53EF\u7372\u5F97\u52DD\u5229\u3002\r\n\r\n\u6230\u9B25\u4E2D\u4F7F\u7528\u7684\u9053\u5177\u548C\u5012\u4E0B\u7684\u5E15\u9B6F\u5C07\u5728\u6230\u9B25\u7D50\u675F\u5F8C\u6062\u5FA9\u539F\u72C0\u3002\r\n\u203B\u5728\u7AF6\u6280\u5834\u5167\u7121\u6CD5\u4F7F\u7528\u6D88\u8017\u9053\u5177\r\n\u203B\u7AF6\u6280\u5834\u5167\u7121\u6CD5\u4F7F\u7528\u5E15\u9B6F\u7403\u6B66\u5668\u8207\u5177\u6709\u589E\u76CA\u6548\u679C\u7684\u6B66\u5668\r\n\r\n\u52DD\u5229\u5F8C\u5C07\u7372\u5F97\u6BB5\u4F4D\u9EDE\u6578\uFF08RP\uFF09\uFF0C\u7D2F\u7A4D\u4E00\u5B9A\u6BB5\u4F4D\u9EDE\u6578\u5F8C\u5373\u53EF\u63D0\u5347\u6BB5\u4F4D\u3002\r\n\u800C\u6230\u6557\u6642\u5C07\u5931\u53BB\u4E00\u5B9A\u7684RP\u3002\r\n\r\n\u9664\u4E86\u89AA\u81EA\u53C3\u6230\u4E4B\u5916\uFF0C\u9084\u53EF\u4EE5\u65C1\u89C0\u5176\u4ED6\u73A9\u5BB6\u4E4B\u9593\u6B63\u5728\u9032\u884C\u7684\u5C0D\u6230\u3002",
    "Help_2_PS5": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u63A7\u5236\u5668\uFF09\r\n\u5DE6\u64CD\u4F5C\u687F : \u79FB\u52D5\r\n\u53F3\u64CD\u4F5C\u687F : \u8996\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|2|/\u003E \u53EC\u559A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|2|/\u003E \u6295\u64F2\u5E15\u9B6F\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|2|/\u003E \u5EFA\u9020\u9078\u55AE\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|2|/\u003E \u8DF3\u8E8D\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|2|/\u003E \u7784\u6E96\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|2|/\u003E \u653B\u64CA\r\n\u003CkeyGuideIcon id=|ReloadAndCoop| OverrideType=|2|/\u003E \u5925\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|2|/\u003E \u5207\u63DB\u6B66\u5668\r\n\u003CkeyGuideIcon id=|RollingAndCrouch| OverrideType=|2|/\u003E \u4E0B\u8E72/\u7FFB\u6EFE\r\n\u003CkeyGuideIcon id=|DashController| OverrideType=|2|/\u003E \u885D\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|2|/\u003E \u6307\u793A\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|2|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|2|/\u003E \u5207\u63DB\u5E15\u9B6F\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|2|/\u003E \u5207\u63DB\u5E15\u9B6F\u7403",
    "Help_43": "\u8DE8\u754C\u5E15\u9B6F\u7D42\u7AEF\r\n\r\n\u53EF\u4EE5\u4FDD\u5B58\u5E15\u9B6F\u7D42\u7AEF\u4E2D\u5E15\u9B6F\u7684\u57FA\u56E0\u5E8F\u5217\uFF0C\u4EE5\u53CA\u900F\u904E\u57FA\u56E0\u5E8F\u5217\u5FA9\u539F\u5E15\u9B6F\u7684\u8A2D\u65BD\u3002\r\n\u4FDD\u5B58\u7684\u5E15\u9B6F\u57FA\u56E0\u5E8F\u5217\u53EF\u4EE5\u5E36\u5230\u5176\u4ED6\u4E16\u754C\u4F7F\u7528\u3002\r\n\u4F46\u662F\uFF0C\u540C\u4E00\u4E16\u754C\u5167\u7121\u6CD5\u540C\u6642\u5B58\u57282\u96BB\u53CA\u4EE5\u4E0A\u5177\u6709\u76F8\u540C\u57FA\u56E0\u5E8F\u5217\u7684\u5E15\u9B6F\u3002\r\n\r\n\u203B\u5982\u679C\u5728\u4E16\u754C\u8A2D\u5B9A\u4E2D\uFF0C\u8A2D\u5B9A\u4E0D\u80FD\u4FDD\u5B58\u548C\u5FA9\u539F\u5E15\u9B6F\u7684\u57FA\u56E0\u5E8F\u5217\u7684\u8A71\uFF0C\u4E5F\u5C31\u7121\u6CD5\u9032\u884C\u5E15\u9B6F\u57FA\u56E0\u5E8F\u5217\u7684\u4FDD\u5B58\u548C\u5FA9\u539F\u64CD\u4F5C\u3002",
    "Help_44": "\u5982\u679C\u88AB\u5730\u5F62\u5361\u4F4F\u4E86\r\n\r\n\u53EF\u4EE5\u900F\u904E\u4F7F\u7528\u9078\u55AE\u4E2D\u7684\u300C\u6B7B\u4EA1\u5F8C\u91CD\u751F\u300D\u9078\u9805\uFF0C\u85C9\u7531\u6B7B\u4EA1\u4E26\u91CD\u751F\u7684\u65B9\u5F0F\u56DE\u5230\u64DA\u9EDE\u3002\r\n\u6B64\u5916\uFF0C\u904A\u6232\u5167\u9084\u5B58\u5728\u8457\u80FD\u5FEB\u901F\u56DE\u5230\u64DA\u9EDE\u7684\u9053\u5177\uFF0C\u6216\u662F\u64C1\u6709\u50B3\u9001\u80FD\u529B\u7684\u5E15\u9B6F\uFF0C\u80FD\u5920\u5E6B\u52A9\u4F60\u8FD4\u56DE\u64DA\u9EDE\u3002\r\n\u5617\u8A66\u53BB\u5C0B\u627E\u770B\u770B\u5427\u3002",
    "Help_45": "\u91E3\u9B5A\r\n\r\n\u88DD\u5099\u91E3\u7AFF\uFF0C\u4E26\u5F9E\u80CC\u5305\u5167\u9078\u64C7\u9B5A\u990C\u3002\u5728\u80FD\u770B\u898B\u9B5A\u5F71\u7684\u6C34\u908A\u6309\u4F4F\u003CkeyGuideIcon id=|WeaponReady|/\u003E\u67B6\u8D77\u91E3\u7AFF\u5F8C\uFF0C\u6309\u4E0B\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u62CB\u51FA\u91E3\u990C\u5C31\u80FD\u958B\u59CB\u91E3\u9B5A\u3002\r\n\u5728\u9A0E\u4E58\u5E15\u9B6F\u7684\u72C0\u614B\u4E0B\u4E5F\u53EF\u4EE5\u9032\u884C\u91E3\u9B5A\u3002\r\n\r\n\u5E15\u9B6F\u9760\u8FD1\u9B5A\u990C\u4E26\u5728\u6D6E\u6F02\u4E0B\u6C89\u5F8C\uFF0C\u6293\u6E96\u6642\u6A5F\u6309\u4E0B\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u5C31\u6703\u6210\u529F\u4E0A\u9264\u3002\r\n\r\n\u4E0A\u9264\u5F8C\u5C07\u9032\u5165\u5C0F\u904A\u6232\uFF0C\u8ACB\u76E1\u91CF\u7DAD\u6301\u5224\u5B9A\u689D\u8207\u9B5A\u7684\u5716\u793A\u91CD\u758A\u3002\r\n\u6309\u4F4F\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u5C07\u4F7F\u5224\u5B9A\u689D\u5F80\u53F3\u79FB\u52D5\uFF0C\u9B06\u958B\u5247\u6703\u56DE\u5230\u5DE6\u908A\u3002\r\n\u56E0\u70BA\u5E15\u9B6F\u5728\u6399\u624E\u4E2D\u6703\u5DE6\u53F3\u79FB\u52D5\uFF0C\u6839\u64DA\u5176\u52D5\u5411\u8ABF\u6574\u5224\u5B9A\u689D\u4F4D\u7F6E\uFF0C\u4F7F\u5B83\u8207\u9B5A\u5716\u793A\u7DAD\u6301\u91CD\u758A\u662F\u91E3\u9B5A\u7684\u91CD\u9EDE\u3002\r\n\r\n\u5224\u5B9A\u689D\u548C\u9B5A\u7684\u5716\u793A\u91CD\u758A\u6642\uFF0C\u6355\u7372\u8A08\u91CF\u69FD\u6703\u9010\u6F38\u7D2F\u7A4D\u3002\r\n\u6355\u7372\u8A08\u91CF\u69FD\u9054\u5230\u6700\u5927\u6642\u5C31\u6703\u6210\u529F\u91E3\u8D77\uFF0C\u4E26\u7372\u5F97\u5E15\u9B6F\u6216\u9053\u5177\u3002\r\n\r\n\u5F37\u5316\u91E3\u7AFF\u548C\u91E3\u990C\u53EF\u4EE5\u964D\u4F4E\u5C0F\u904A\u6232\u7684\u96E3\u5EA6\u3002\r\n\u91E3\u4E0A\u7684\u7375\u7269\u8D8A\u5927\uFF0C\u6D88\u8017\u91E3\u7AFF\u7684\u8010\u4E45\u5EA6\u5C31\u8D8A\u591A\u3002\r\n\u7576\u89BA\u5F97\u91E3\u9B5A\u56F0\u96E3\u6642\uFF0C\u53EF\u4EE5\u8A66\u8457\u88FD\u4F5C\u66F4\u9AD8\u6027\u80FD\u7684\u91E3\u7AFF\u6216\u91E3\u990C\uFF0C\u91CD\u65B0\u9032\u884C\u6311\u6230\u3002\r\n\u6B64\u5916\uFF0C\u4E5F\u5B58\u5728\u8457\u80FD\u5920\u8F14\u52A9\u73A9\u5BB6\u91E3\u9B5A\u7684\u5E15\u9B6F\uFF0C\u53BB\u5C0B\u627E\u7260\u5011\u5427\u3002"
  }
