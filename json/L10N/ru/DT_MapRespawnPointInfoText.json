{
  "namespace": "DT_MapRespawnPointInfoText",
  "fields": {
    "SpawnPoint_1": "\u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u0445\u043E\u043B\u043C\u0430.\r\n\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043E\u0431\u0437\u043E\u0440 \u0438 \u043C\u043D\u043E\u0433\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432.\r\n\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432.",
    "SpawnPoint_1_Title": "\u0425\u043E\u043B\u043C\u044B \u0432\u0435\u0442\u0440\u043E\u0432 - \u041F\u043B\u043E\u0441\u043A\u043E\u0433\u043E\u0440\u044C\u0435 \u041D\u0430\u0447\u0430\u043B",
    "SpawnPoint_2": "\u041F\u0435\u0441\u0447\u0430\u043D\u043E\u0435 \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435. \u0412 \u043E\u043A\u0440\u0443\u0433\u0435 \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u043D\u044B\u0445 \u041F\u0430\u043B\u043E\u0432.\r\n\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u0440\u0435\u0434\u043A\u0438, \u043D\u043E \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0430 \u041F\u0430\u043B\u0430\u043C\u0438.",
    "SpawnPoint_2_Title": "\u0425\u043E\u043B\u043C\u044B \u0432\u0435\u0442\u0440\u043E\u0432 - \u0411\u0435\u0440\u0435\u0433 \u043B\u0435\u0442\u0443\u0447\u0438\u0445 \u0440\u044B\u0431",
    "SpawnPoint_3": "\u041C\u043E\u0440\u0441\u043A\u043E\u0439 \u0431\u0435\u0440\u0435\u0433, \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439 \u0440\u0438\u0444\u0430\u043C\u0438.\r\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u041F\u0430\u043B\u043E\u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u0435.\r\n\u041C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043A\u0430\u043B\u0438\u0441\u0442\u0430\u044F, \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A.",
    "SpawnPoint_3_Title": "\u0410\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433 \u043C\u043E\u0440\u0441\u043A\u0438\u0445 \u0432\u0435\u0442\u0440\u043E\u0432 - \u0420\u0438\u0444",
    "SpawnPoint_4": "\u041F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u043C\u044B\u0439 \u043C\u043E\u0440\u0441\u043A\u0438\u043C\u0438 \u0432\u0435\u0442\u0440\u0430\u043C\u0438 \u043E\u0441\u0442\u0440\u043E\u0432.\r\n\u0411\u043B\u0438\u0437\u043E\u0441\u0442\u044C \u0432\u0443\u043B\u043A\u0430\u043D\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u044B\u0439 \u0434\u043B\u044F \u0436\u0438\u0437\u043D\u0438 \u0442\u0435\u043F\u043B\u044B\u0439 \u043A\u043B\u0438\u043C\u0430\u0442.\r\n\u041E\u0442\u0441\u044E\u0434\u0430 \u043B\u0435\u0433\u043A\u043E \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0446\u0435\u043D\u0442\u0440 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0437\u0435\u043C\u043B\u0438, \u0438 \u0432\u044B \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0437\u0430\u0441\u043A\u0443\u0447\u0430\u0435\u0442\u0435.",
    "SpawnPoint_4_Title": "\u0410\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433 \u041C\u043E\u0440\u0441\u043A\u0438\u0445 \u0412\u0435\u0442\u0440\u043E\u0432 \u2014 \u0411\u0435\u0440\u0435\u0433 \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u0432\u0448\u0438\u0445 \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0435",
    "SpawnPoint_5": "\u0411\u0435\u0437\u043B\u044E\u0434\u043D\u044B\u0439 \u043E\u0441\u0442\u0440\u043E\u0432, \u043B\u0435\u0436\u0430\u0449\u0438\u0439 \u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0437\u0435\u043C\u043B\u0438.\r\n\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435.\r\n\u0420\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u041F\u0430\u043B\u043E\u0432 \u043C\u0430\u043B\u043E, \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0436\u0438\u0437\u043D\u0438 \u0442\u0440\u0443\u0434\u043D\u044B\u0435.",
    "SpawnPoint_5_Title": "\u0417\u0430\u0431\u044B\u0442\u044B\u0439 \u043E\u0441\u0442\u0440\u043E\u0432",
    "SpawnPoint_6": "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440 \u0434\u0443\u0435\u0442 \u0441 \u0421\u043D\u0435\u0436\u043D\u043E\u0439 \u0433\u043E\u0440\u044B \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432.\r\n\u041D\u043E\u0447\u044C\u044E \u0445\u043E\u043B\u043E\u0434 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u044B\u0439, \u0438 \u0434\u0430\u0436\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0436\u0438\u0442\u0435\u043B\u0438 \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0436\u0438\u0432\u0443\u0442.",
    "SpawnPoint_6_Title": "\u041E\u0441\u0442\u0440\u043E\u0432 \u043B\u0435\u0434\u044F\u043D\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430",
    "SpawnPoint_7": "\u0414\u0438\u043A\u0438\u0439 \u043E\u0441\u0442\u0440\u043E\u0432 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435.\r\n\u041D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043A\u0440\u0430\u044E \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u0430, \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F \u0435\u0433\u043E \u043E\u0441\u0432\u0430\u0438\u0432\u0430\u0442\u044C.\r\n\u041D\u0435\u043E\u043F\u044B\u0442\u043D\u044B\u043C \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u043E \u0436\u0438\u0442\u044C.",
    "SpawnPoint_7_Title": "\u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0439 \u0434\u0438\u043A\u0438\u0439 \u043E\u0441\u0442\u0440\u043E\u0432",
    "SpawnPoint_8": "\u0422\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E \u043E\u0441\u0442\u0440\u043E\u0432\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442 \u0431\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0435 \u0440\u0430\u0432\u043D\u0438\u043D\u044B.\r\n\u0423\u043C\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u043E\u0431\u0438\u043B\u044C\u043D\u043E\u043C\u0443 \u0440\u043E\u0441\u0442\u0443 \u044F\u0433\u043E\u0434.\r\n\u0422\u0430\u043A\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u0443\u0434\u043E\u0431\u043D\u044B\u0439 \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0446\u0435\u043D\u0442\u0440\u0443 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0437\u0435\u043C\u043B\u0438.",
    "SpawnPoint_8_Title": "\u0411\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0439 \u043E\u0441\u0442\u0440\u043E\u0432",
    "FTPoint1": "\u041E\u0431\u0441\u0438\u0434\u0438\u0430\u043D\u043E\u0432\u044B\u0439 \u0432\u0443\u043B\u043A\u0430\u043D - \u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0441\u043A\u043B\u043E\u043D",
    "FTPoint2": "\u0411\u0430\u0448\u043D\u044F \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439 \u042D\u0439\u0440\u0435\u043D\u0430",
    "FTPoint3": "\u0411\u0430\u0448\u043D\u044F \u0411\u0440\u0430\u0442\u0441\u0442\u0432\u0430 \u0412\u0435\u0447\u043D\u043E\u0433\u043E \u041F\u043B\u0430\u043C\u0435\u043D\u0438 - \u0412\u0445\u043E\u0434",
    "FTPoint4": "\u0420\u0443\u0438\u043D\u044B \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438",
    "FTPoint5": "\u0414\u0430\u043B\u044C\u043D\u044F\u044F \u0440\u044B\u0431\u0430\u0446\u043A\u0430\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u044F",
    "FTPoint6": "\u0421\u0442\u0430\u0442\u0443\u044F \u0410\u043D\u0443\u0431\u0438\u0441\u0430 \u043D\u0430 \u041E\u0431\u0441\u0438\u0434\u0438\u0430\u043D\u043E\u0432\u043E\u043C \u0432\u0443\u043B\u043A\u0430\u043D\u0435",
    "FTPoint7": "\u0411\u0435\u0440\u0435\u0433 \u0432\u0435\u0447\u043D\u043E\u0433\u043E \u043B\u0435\u0442\u0430",
    "FTPoint8": "\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0439 \u0433\u043E\u0440\u043E\u0434-\u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C",
    "FTPoint9": "\u0411\u0430\u0448\u043D\u044F \u0412\u0438\u0433\u0438\u043B\u0430\u043D\u0442\u043E\u0432 - \u0412\u0445\u043E\u0434",
    "FTPoint10": "\u0411\u0434\u0438\u043D\u0430\u044F \u0431\u0430\u0448\u043D\u044F",
    "FTPoint11": "\u0412\u0445\u043E\u0434 \u0432 \u0434\u044E\u043D\u044B",
    "FTPoint12": "\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u0433\u043E\u0440\u043E\u0434",
    "FTPoint13": "\u0413\u043B\u0443\u0431\u044C \u0434\u044E\u043D",
    "FTPoint14": "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0431\u0435\u0440\u0435\u0433",
    "FTPoint15": "\u041D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u0430\u044F \u0433\u043E\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430",
    "FTPoint16": "\u0425\u043E\u043B\u043C \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u043B\u0430\u0441\u043A\u0438",
    "FTPoint17": "\u041D\u0435\u0442\u0430\u044E\u0449\u0435\u0435 \u043E\u0437\u0435\u0440\u043E",
    "FTPoint18": "\u0417\u0435\u043C\u043B\u044F \u0432\u0435\u0447\u043D\u043E\u0439 \u043C\u0435\u0440\u0437\u043B\u043E\u0442\u044B",
    "FTPoint19": "\u0411\u0430\u0448\u043D\u044F \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439",
    "FTPoint20": "\u0411\u0430\u0448\u043D\u044F \u041E\u0442\u0440\u044F\u0434\u0430 \u0413\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 - \u0412\u0445\u043E\u0434",
    "FTPoint21": "\u0425\u043E\u043B\u043C\u044B \u0442\u0440\u0430\u0432\u044F\u043D\u043E\u0433\u043E \u0433\u0438\u0433\u0430\u043D\u0442\u0430",
    "FTPoint22": "\u0412\u0435\u0442\u0445\u0430\u044F \u0446\u0435\u0440\u043A\u043E\u0432\u044C",
    "FTPoint23": "\u041F\u043B\u043E\u0441\u043A\u043E\u0433\u043E\u0440\u044C\u0435 \u041D\u0430\u0447\u0430\u043B",
    "FTPoint24": "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435",
    "FTPoint25": "\u0412\u043E\u0434\u043E\u043F\u0430\u0434 \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A\u0430",
    "FTPoint26": "\u041F\u043E\u0434\u043D\u043E\u0436\u044C\u0435 \u0432\u0443\u043B\u043A\u0430\u043D\u0430",
    "FTPoint27": "\u041E\u0431\u0438\u0442\u0435\u043B\u044C \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u043F\u0442\u0438\u0446\u044B",
    "FTPoint28": "\u0420\u0443\u0438\u043D\u044B \u0431\u0430\u0441\u0442\u0438\u043E\u043D\u0430",
    "FTPoint29": "\u041E\u0431\u0438\u0442\u0435\u043B\u044C \u0433\u0440\u043E\u043C\u043E\u0432\u043E\u0433\u043E \u0434\u0440\u0430\u043A\u043E\u043D\u0430",
    "FTPoint30": "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439",
    "FTPoint31": "\u0414\u0440\u0435\u0432\u043D\u0435\u0435 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435",
    "FTPoint32": "\u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u0413\u043E\u0440\u044B \u0424\u043B\u043E\u043F\u0438",
    "FTPoint33": "\u0426\u0435\u043D\u0442\u0440 \u043E\u0437\u0435\u0440\u0430",
    "FTPoint34": "\u0425\u043E\u043B\u043C \u043B\u0438\u0446\u0435\u043C\u0435\u0440\u043E\u0432",
    "FTPoint35": "\u041E\u0431\u0438\u0442\u0435\u043B\u044C \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F",
    "FTPoint36": "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u043D\u0430 \u0421\u043D\u0435\u0436\u043D\u0443\u044E \u0433\u043E\u0440\u0443",
    "FTPoint37": "\u0411\u0430\u0448\u043D\u044F \u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u043F\u043E \u0417\u0430\u0449\u0438\u0442\u0435 \u041F\u0430\u043B\u043E\u0432 - \u0412\u0445\u043E\u0434",
    "FTPoint38": "\u041E\u0431\u0438\u0442\u0435\u043B\u044C \u043C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438",
    "FTPoint39": "\u041B\u0435\u0441 \u0442\u0440\u0430\u0432\u044F\u043D\u044B\u0445 \u043F\u0430\u043D\u0434",
