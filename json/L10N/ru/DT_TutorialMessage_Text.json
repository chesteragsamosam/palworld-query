{
  "namespace": "DT_TutorialMessage_Text",
  "fields": {
    "TUTORIAL_SP_1": "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u003CkeyGuideIcon id=|Interact_1|/\u003E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442.",
    "TUTORIAL_ITEM_1": "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043C\u0435\u043D\u044E \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u003CkeyGuideIcon id=|OpenConstructionMenu|/\u003E",
    "TUTORIAL_ITEM_2": "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u003CkeyGuideIcon id=|ThrowObject|/\u003E, \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0444\u0435\u0440\u0443 \u0438 \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u041F\u0430\u043B\u0430.\r\n\u041E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u044B\u0445 \u041F\u0430\u043B\u043E\u0432 \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043F\u0440\u043E\u0449\u0435.",
    "TUTORIAL_ITEM_3": "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043C\u0435\u043D\u044E \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u003CkeyGuideIcon id=|OpenConstructionMenu|/\u003E\r\n\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u041F\u0430\u043B\u0431\u043E\u043A\u0441, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043B\u043E\u0436\u0438\u0442\u044C \u0431\u0430\u0437\u0443.",
    "TUTORIAL_ITEM_4": "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u043B\u043E\u0434 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u0438\u0437 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F,\r\n\u0447\u0442\u043E\u0431\u044B \u043E\u0431\u0443\u0447\u0438\u0442\u044C \u041F\u0430\u043B\u0430 \u043D\u043E\u0432\u043E\u043C\u0443 \u043D\u0430\u0432\u044B\u043A\u0443.",
    "TUTORIAL_ITEM_5": "\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u003CitemName id=|Relic|/\u003E \u0438 \u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043C\u043E\u043D\u0443\u043C\u0435\u043D\u0442\u0443 \u003CMapObjectName id=|BuildableGoddessStatue|/\u003E,\r\n\u0447\u0442\u043E\u0431\u044B \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u043D\u0430\u0432\u044B\u043A \u043F\u043E\u0438\u043C\u043A\u0438 \u041F\u0430\u043B\u043E\u0432.",
    "TUTORIAL_ITEM_6": "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u003CkeyGuideIcon id=|Jump|/\u003E \u0432 \u043F\u0440\u044B\u0436\u043A\u0435, \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442\u044C \u043D\u0430 \u0433\u043B\u0430\u0439\u0434\u0435\u0440\u0435.",
    "TUTORIAL_ITEM_7": "\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u003CMapObjectName id=|HatchingPalEgg|/\u003E,\r\n\u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u041F\u0430\u043B\u043E\u0432 \u0438\u0437 \u044F\u0438\u0446.",
    "TUTORIAL_RESPAWN_1": "\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0432 \u041F\u0430\u043B\u0431\u043E\u043A\u0441, \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0432 \u043C\u0435\u0441\u0442\u0435 \u0435\u0433\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438.",
    "TUTORIAL_RESPAWN_2": "\u041D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u041F\u0430\u043B\u044B \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B.\r\n\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0445, \u043F\u043E\u043A\u0430 \u044D\u0442\u043E \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0435.",
    "TUTORIAL_INDIVIDUAL_1": "\u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043E\u0447\u043A\u043E\u0432 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439\r\n\u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438.",
    "TUTORIAL_INDIVIDUAL_2": "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u003CkeyGuideIcon id=|OpenCharacterMenu|/\u003E\r\n\u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u044C\u0442\u0435 \u043E\u0447\u043A\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430.",
    "TUTORIAL_INDIVIDUAL_3": "\u0413\u043E\u043B\u043E\u0434 \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438.\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0438\u0437 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0435\u0441\u0442\u044C.",
    "TUTORIAL_INDIVIDUAL_4": "\u041A\u043E\u0433\u0434\u0430 \u041F\u0430\u043B\u044B \u0433\u043E\u043B\u043E\u0434\u043D\u044B, \u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0441\u043D\u0438\u0436\u0430\u044E\u0442\u0441\u044F.\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0438\u0437 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u041F\u0430\u043B\u043E\u0432.",
    "TUTORIAL_INDIVIDUAL_5": "\u041F\u0440\u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430 \u041F\u0430\u043B\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u043B\u0435\u043D\u0438\u0442\u044C\u0441\u044F \u0438\u043B\u0438 \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u0442\u044C.\r\n\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u0435 \u0438\u0445 \u0438\u043B\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F.",
    "TUTORIAL_INDIVIDUAL_6": "\u0412\u0430\u0448 \u041F\u0430\u043B \u0437\u0430\u0431\u043E\u043B\u0435\u043B.\r\n\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0438\u0441\u0446\u0435\u043B\u0438\u0442\u044C.",
    "TUTORIAL_INDIVIDUAL_7": "\u0412 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u0440\u0430\u0431\u043E\u0442\u044B \u0440\u0430\u0441\u0441\u0443\u0434\u043E\u043A \u041F\u0430\u043B\u043E\u0432 \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F, \u0438 \u043E\u043D\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0445\u0430\u043B\u0442\u0443\u0440\u0438\u0442\u044C.\r\n\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A, \u0447\u0442\u043E\u0431\u044B \u041F\u0430\u043B \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0440\u0430\u0431\u043E\u0442\u0435.",
    "TUTORIAL_CAPTURE_1": "\u0414\u0438\u043A\u0438\u0445 \u041F\u0430\u043B\u043E\u0432 \u043F\u0440\u043E\u0449\u0435 \u043F\u043E\u0439\u043C\u0430\u0442\u044C, \u0435\u0441\u043B\u0438 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0438\u0445 \u003CuiCommon id=|COMMON_STATUS_HP|/\u003E.\r\n\u0415\u0441\u043B\u0438 \u0432\u044B \u0438\u0445 \u0443\u0431\u044C\u0451\u0442\u0435, \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F.",
    "TUTORIAL_CAPTURE_2": "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u003CkeyGuideIcon id=|ThrowPal|/\u003E, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u043E\u0433\u043E \u041F\u0430\u043B\u0430.",
    "TUTORIAL_CAPTURE_3": "\u0417\u0430 \u043F\u043E\u0438\u043C\u043A\u0443 \u043D\u043E\u0432\u043E\u0433\u043E \u0432\u0438\u0434\u0430 \u041F\u0430\u043B\u0430 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u043F\u044B\u0442\u0430.\r\n\u041F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C \u0434\u0430\u043B\u044C\u0448\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u043D\u043E\u0432\u044B\u0445 \u041F\u0430\u043B\u043E\u0432.",
    "TUTORIAL_CAPTURE_4": "\u0417\u0430 \u043F\u043E\u0438\u043C\u043A\u0443 \u0434\u043E 12 \u043E\u0441\u043E\u0431\u0435\u0439 \u0443\u0436\u0435 \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u044B\u0445 \u041F\u0430\u043B\u043E\u0432\r\n\u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u043F\u044B\u0442.",
    "TUTORIAL_CAPTURE_5": "\u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043D\u043E\u0441\u0438\u0442\u044C \u043D\u0435 \u0431\u043E\u043B\u0435\u0435 5 \u041F\u0430\u043B\u043E\u0432.\r\n\u0415\u0441\u043B\u0438 \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435, \u043E\u043D\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432 \u041F\u0430\u043B\u0431\u043E\u043A\u0441.",
    "TUTORIAL_CAPTURE_6": "\u0412\u044B \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0443\u0434\u0430\u0447\u043B\u0438\u0432\u043E\u0433\u043E \u041F\u0430\u043B\u0430!\r\n\u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u043D \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043E\u0441\u043E\u0431\u044B\u043C \u043D\u0430\u0432\u044B\u043A\u043E\u043C.",
    "TUTORIAL_CAPTURE_7": "\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u041F\u0430\u043B\u0431\u043E\u043A\u0441, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u044B\u043C \u041F\u0430\u043B\u0430\u043C.",
    "TUTORIAL_CAPTURE_8": "\u0412\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u041F\u0430\u043B\u043E\u043C \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F!\r\n\u0415\u0433\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u0434\u043E \u0443\u0440\u043E\u0432\u043D\u044F \u0438\u0433\u0440\u043E\u043A\u0430.",
    "TUTORIAL_COMMON_1": "\u041A\u043E\u0433\u0434\u0430 \u0432\u0435\u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 \u043F\u0440\u0435\u0434\u0435\u043B, \u0432\u044B \u0442\u0435\u0440\u044F\u0435\u0442\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F.\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043E\u0447\u043A\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u043C\u0430\u043A\u0441. \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u043C\u044B\u0439 \u0432\u0435\u0441.",
    "TUTORIAL_COMMON_2": "\u041F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u043E\u0439 \u0444\u0430\u043A\u0435\u043B \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430.\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0432\u0435\u0440\u0441\u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C.",
    "TUTORIAL_COMMON_3": "\u0412\u0430\u0448 \u041F\u0430\u043B \u043F\u043E\u0433\u0438\u0431 \u0432 \u0431\u043E\u044E!\r\n\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0433\u043E \u0432 \u041F\u0430\u043B\u0431\u043E\u043A\u0441, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u043E\u0442 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F |\u003CuiCommon id=|COMMON_CONDITION_NAME_Dying|/\u003E|.",
    "TUTORIAL_COMMON_4": "\u0412\u044B\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0435 \u043D\u0430 \u0431\u0430\u0437\u0435 \u041F\u0430\u043B\u044B \u0441\u0430\u043C\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0438 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043A \u043D\u0435\u0439.",
    "TUTORIAL_COMMON_5": "\u0415\u0441\u043B\u0438 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u041F\u0430\u043B\u043E\u0432 \u0438\u0437 \u041F\u0430\u043B\u0431\u043E\u043A\u0441\u0430 \u043D\u0430 \u0431\u0430\u0437\u0435,\r\n\u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0432\u0430\u043C \u0441 \u0440\u0430\u0431\u043E\u0442\u043E\u0439, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u044B.",
    "TUTORIAL_COMMON_6": "\u041F\u0430\u043B\u0443 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u043D\u0435 \u0431\u043E\u043B\u0435\u0435 \u0442\u0440\u0451\u0445 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u043D\u0430\u0432\u044B\u043A\u043E\u0432.\r\n\u0421\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430\u0432\u044B\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u0432 \u043C\u0435\u043D\u044E \u003CuiCommon id=|INGAME_MAIN_MENU_PAL|/\u003E.",
    "TUTORIAL_COMMON_7": "\u0414\u0438\u043A\u0438\u0435 \u041F\u0430\u043B\u044B \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B, \u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C \u0438\u0445 \u0433\u043E\u043B\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438 \u0441\u043B\u043E\u0436\u043D\u043E.\r\n\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0432\u0435\u0440\u0441\u0442\u0430\u043A \u0438 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435.",
    "TUTORIAL_COMMON_8": "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u044B \u0437\u0430\u043F\u0438\u0441\u043A\u0438 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0446\u0435\u0432.\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u043C\u043E\u0436\u043D\u043E \u0438\u0437 \u044D\u043A\u0440\u0430\u043D\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A."
  }
}