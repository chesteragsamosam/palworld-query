  "namespace": "DT_MapRespawnPointInfoText",
  "fields": {
    "SpawnPoint_1": "\uBD09\uAE0B\uD55C \uC5B8\uB355 \uC704.\r\n\uC804\uB9DD\uC774 \uD0C1 \uD2B8\uC774\uACE0 \uC790\uC6D0\uB3C4 \uD48D\uBD80\uD55C \uB355\uC5D0\r\n\uCC98\uC74C \uD50C\uB808\uC774\uD558\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uCD94\uCC9C.",
    "SpawnPoint_1_Title": "\uBC14\uB78C \uBD80\uB294 \uC5B8\uB355 - \uC2DC\uCD08\uC758 \uB300\uC9C0",
    "SpawnPoint_2": "\uD574\uBCC0\uC758 \uBAA8\uB798\uC0AC\uC7A5. \uC218\uC0DD \uD330\uC774 \uB9CE\uB2E4.\r\n\uB098\uBB34\uB294 \uC801\uC73C\uB098 \uD330\uC774 \uAF64 \uC0B4\uACE0 \uC788\uB2E4.",
    "SpawnPoint_2_Title": "\uBC14\uB78C \uBD80\uB294 \uC5B8\uB355 - \uB0A0\uCE58 \uD574\uC548",
    "SpawnPoint_3": "\uBC14\uB2F7\uBC14\uB78C\uC774 \uBD80\uB294 \uC12C.\r\n\uD654\uC0B0\uACFC \uC778\uC811\uD558\uC5EC \uAE30\uD6C4\uAC00 \uC628\uB09C\uD558\uACE0 \uC0B4\uAE30 \uD3B8\uD558\uB2E4.\r\n\uBCF8\uD1A0 \uC911\uC559\uC73C\uB85C \uAC74\uB108\uAC00\uAE30 \uC26C\uC6B0\uBA70, \uB2E4\uC591\uD55C \uBAA8\uD5D8\uC744 \uC990\uAE38 \uC218 \uC788\uB294 \uACF3.",
    "SpawnPoint_3_Title": "\uBC14\uB2F7\uBC14\uB78C \uAD70\uB3C4 - \uC554\uCD08",
    "SpawnPoint_4": "\uC554\uCD08\uAC00 \uD3BC\uCCD0\uC9C4 \uD574\uC548.\r\n\uC790\uC6D0\uC774\uB098 \uD330 \uC591\uC740 \uD3C9\uADE0\uC801.\r\n\uBC14\uC704\uAC00 \uC880 \uB9CE\uC9C0\uB9CC \uB113\uC740 \uD1A0\uC9C0\uB97C \uD655\uBCF4\uD560 \uC218 \uC788\uB2E4.",
    "SpawnPoint_4_Title": "\uBC14\uB2F7\uBC14\uB78C \uAD70\uB3C4 - \uD45C\uB958\uC790\uC758 \uD574\uC548",
    "SpawnPoint_5": "\uBCF8\uD1A0\uC5D0\uC11C \uBA3C, \uC778\uAE30\uCC99\uC774 \uC548 \uB290\uAEF4\uC9C0\uB294 \uC12C.\r\n\uBD81\uCABD\uC5D0 \uC704\uCE58\uD55C \uD0D3\uC5D0 \uAE30\uC628\uB3C4 \uB0AE\uC740 \uD3B8\uC774\uB2E4.\r\n\uC790\uC6D0\uC774\uB098 \uD330\uC758 \uC591\uC774 \uC801\uC5B4 \uAC70\uC8FC\uD558\uAE30 \uD798\uB4E4\uB2E4.",
    "SpawnPoint_5_Title": "\uC78A\uD78C \uC12C",
    "SpawnPoint_6": "\uC124\uC0B0\uC5D0\uC11C \uCC28\uAC00\uC6B4 \uBC14\uB78C\uC774 \uBD88\uC5B4\uC624\uB294 \uC12C.\r\n\uBC24\uC774 \uB418\uBA74 \uAE30\uC628\uC774 \uAE09\uACA9\uD788 \uB5A8\uC5B4\uC9C0\uB294 \uD0D3\uC5D0,\r\n\uC6D0\uC8FC\uBBFC\uB3C4 \uC880\uCC98\uB7FC \uC5EC\uAE30\uC11C \uC0B4\uB824 \uD558\uC9C0 \uC54A\uB294\uB2E4.",
    "SpawnPoint_6_Title": "\uCC2C \uBC14\uB78C\uC774 \uBD80\uB294 \uC12C",
    "SpawnPoint_7": "\uB3D9\uCABD\uC5D0 \uC704\uCE58\uD55C \uD669\uB7C9\uD55C \uC12C.\r\n\uB300\uB959 \uB05D\uC790\uB77D\uC5D0 \uC788\uC73C\uBA70, \uC544\uBB34\uB3C4 \uAC1C\uCC99\uD558\uB824 \uD558\uC9C0 \uC54A\uB294\uB2E4.\r\n\uC775\uC219\uD558\uC9C0 \uC54A\uC740 \uC0AC\uB78C\uC774 \uC0B4\uAE30\uC5D4 \uC880 \uD798\uB4E4\uB2E4.",
    "SpawnPoint_7_Title": "\uB3D9\uCABD\uC758 \uD669\uB7C9\uD55C \uC12C",
    "SpawnPoint_8": "\uC2B5\uC9C0\uB300\uAC00 \uD3BC\uCCD0\uC9C4 \uC12C.\r\n\uC2B5\uB3C4\uAC00 \uC801\uB2F9\uD574 \uC5F4\uB9E4\uAC00 \uC794\uB729 \uC5F4\uB9B0\uB2E4.\r\n\uBCF8\uD1A0 \uC911\uC559\uC73C\uB85C \uAC00\uAE30\uC5D0\uB3C4 \uC6A9\uC774\uD558\uB2E4.",
    "SpawnPoint_8_Title": "\uC2B5\uC6D0\uC9C0 \uC12C",
