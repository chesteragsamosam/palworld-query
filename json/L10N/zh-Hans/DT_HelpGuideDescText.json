  "fields": {
    "Help_1": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u952E\u76D8\uFF09\r\n\r\n\u9F20\u6807 \u89C6\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|W_ForHelp|/\u003E\u003CkeyGuideIcon id=|A_ForHelp|/\u003E\u003CkeyGuideIcon id=|S_ForHelp|/\u003E\u003CkeyGuideIcon id=|D_ForHelp|/\u003E \u79FB\u52A8\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|1|/\u003E \u53EC\u5524\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|1|/\u003E \u6295\u63B7\u5E15\u9C81\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|1|/\u003E \u5EFA\u7B51\u83DC\u5355\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|1|/\u003E \u8DF3\u8DC3\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|1|/\u003E \u7784\u51C6\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|1|/\u003E \u653B\u51FB\r\n\u003CkeyGuideIcon id=|Coop| OverrideType=|1|/\u003E \u4F19\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|Reload| OverrideType=|1|/\u003E \u91CD\u65B0\u88C5\u586B\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|1|/\u003E\u003CkeyGuideIcon id=|ChangeWeaponPrev| OverrideType=|1|/\u003E \u6B66\u5668\u5207\u6362\r\n\u003CkeyGuideIcon id=|Crouch| OverrideType=|1|/\u003E \u4E0B\u8E72\r\n\u003CkeyGuideIcon id=|Rolling| OverrideType=|1|/\u003E \u7FFB\u6EDA\r\n\u003CkeyGuideIcon id=|Dash| OverrideType=|1|/\u003E \u51B2\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|1|/\u003E \u5E15\u9C81\u6307\u4EE4\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|1|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|1|/\u003E \u5207\u6362\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|1|/\u003E \u5207\u6362\u5E15\u9C81\u7403",
    "Help_2": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u63A7\u5236\u5668\uFF09\r\n\u5DE6\u6447\u6746 \u79FB\u52A8\r\n\u53F3\u6447\u6746 \u89C6\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|2|/\u003E \u53EC\u5524\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|2|/\u003E \u6295\u63B7\u5E15\u9C81\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|2|/\u003E \u5EFA\u7B51\u83DC\u5355\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|2|/\u003E \u8DF3\u8DC3\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|2|/\u003E \u7784\u51C6\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|2|/\u003E \u653B\u51FB\r\n\u003CkeyGuideIcon id=|ReloadAndCoop| OverrideType=|2|/\u003E \u4F19\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|2|/\u003E \u5207\u6362\u6B66\u5668\r\n\u003CkeyGuideIcon id=|RollingAndCrouch| OverrideType=|2|/\u003E \u4E0B\u8E72/\u7FFB\u6EDA\r\n\u003CkeyGuideIcon id=|DashController| OverrideType=|2|/\u003E \u51B2\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|2|/\u003E \u5E15\u9C81\u6307\u4EE4\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|2|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|2|/\u003E \u5207\u6362\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|2|/\u003E \u5207\u6362\u5E15\u9C81\u7403",
    "Help_3": "\u6E38\u620F\u76EE\u6807\r\n\r\n\u6253\u5012\u6240\u6709\u533A\u57DF\u7684\u9AD8\u5854\u5934\u76EE\uFF0C\u6210\u4E3A\u6700\u5F3A\u7684\u5E15\u9C81\u8BAD\u7EC3\u5BB6\uFF01\r\n\u60F3\u7A33\u624E\u7A33\u6253\u5730\u5F3A\u5316\u81EA\u5DF1\u7684\u636E\u70B9\u4E5F\u597D\uFF0C\u6536\u96C6\u6240\u6709\u5E15\u9C81\u4E5F\u597D\uFF0C\r\n\u8981\u901A\u8FC7\u914D\u79CD\u4E0E\u5F3A\u5316\u6765\u6253\u9020\u6700\u5F3A\u7684\u5E15\u9C81\u5F53\u7136\u4E5F\u6CA1\u95EE\u9898\u3002\r\n\r\n\u548C\u5E15\u9C81\u643A\u624B\u4E00\u8D77\u5728\u8FD9\u7247\u81EA\u7531\u5E7F\u9614\u7684\u5927\u5730\u4E0A\u5C3D\u60C5\u5192\u9669\u5427\uFF01",
    "Help_4": "\u4E00\u5F00\u59CB\u8BE5\u505A\u4E9B\u4EC0\u4E48\u597D\u5462\uFF1F\r\n\r\n\u5148\u6361\u4E9B\u6389\u5728\u5730\u4E0A\u7684\u6811\u679D\u4E0E\u5C0F\u77F3\u5934\uFF0C\u8FD9\u6837\u5C31\u6709\u6728\u6750\u4E0E\u77F3\u5934\u7684\u6765\u6E90\u4E86\u3002\r\n\u7A7A\u624B\u6BB4\u6253\u5927\u6811\u4E0E\u5CA9\u77F3\u540C\u6837\u4E5F\u80FD\u53D6\u5F97\u6728\u6750\u4E0E\u77F3\u5934\u3002\r\n\u5EFA\u9020\u5DE5\u4F5C\u53F0\u5E76\u5236\u4F5C\u65A7\u5934\uFF0C\u5C31\u80FD\u63D0\u5347\u63A1\u96C6\u7684\u6548\u7387\u3002\r\n\r\n\u6536\u96C6\u5230\u4E00\u5B9A\u7D20\u6750\u5E76\u9009\u597D\u636E\u70B9\u4F4D\u7F6E\u540E\uFF0C\u5C31\u6765\u5EFA\u9020\u300C\u5E15\u9C81\u7EC8\u7AEF\u300D\u5427\u3002\r\n\u300C\u5E15\u9C81\u7EC8\u7AEF\u300D\u6240\u5728\u7684\u5730\u65B9\u5C31\u662F\u4F60\u7684\u636E\u70B9\u3002\r\n\r\n\u63D0\u5347\u7B49\u7EA7\u540E\u5C31\u80FD\u5236\u4F5C\u6B66\u5668\u4E0E\u300C\u5E15\u9C81\u7403\u300D\uFF0C\u524A\u5F31\u5E15\u9C81\u7684\u4F53\u529B\u5E76\u6355\u6349\u5B83\u4EEC\u3002\r\n\u5E15\u9C81\u4E0D\u4F46\u80FD\u6210\u4E3A\u6218\u529B\uFF0C\u4E5F\u80FD\u628A\u5B83\u4EEC\u9001\u8FDB\u636E\u70B9\u5F53\u505A\u52B3\u52A8\u529B\u3002\r\n\r\n\u8FD9\u4E2A\u4E16\u754C\u7684\u591C\u665A\u662F\u5F88\u5371\u9669\u7684\u3002\u522B\u5FD8\u4E86\u5236\u4F5C\u300C\u5E8A\u94FA\u300D\u4EE5\u53CA\u300C\u8425\u706B\u300D\u6216\u300C\u706B\u70AC\u300D\uFF0C\u624D\u80FD\u5E73\u5B89\u5EA6\u8FC7\u7B2C\u4E00\u665A\u3002",
    "Help_5": "\u5173\u4E8E\u5E15\u9C81\r\n\r\n\u6B64\u5730\u533A\u6709\u8BB8\u591A\u4E0D\u53EF\u601D\u8BAE\u7684\u751F\u7269\u6816\u606F\uFF0C\u7EDF\u79F0\u4E3A\u300C\u5E15\u9C81\u300D\u3002\r\n\u7528\u5E15\u9C81\u7403\u6355\u6349\u5B83\u4EEC\uFF0C\u5C31\u80FD\u628A\u5B83\u4EEC\u53D8\u6210\u4F19\u4F34\uFF0C\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|ThrowPal|/\u003E\u5C31\u80FD\u628A\u961F\u4F0D\u88E1\u7684\u5E15\u9C81\u4ECE\u5E15\u9C81\u7403\u91CC\u653E\u51FA\u6765\u3002\r\n\r\n\u53EF\u4EE5\u5E26\u5728\u8EAB\u4E0A\u7684\u5E15\u9C81\u6700\u591A5\u96BB\uFF0C\u8D85\u8FC7\u4E0A\u9650\u540E\uFF0C\u6355\u6349\u5230\u7684\u5E15\u9C81\u4F1A\u88AB\u81EA\u52A8\u4F20\u9001\u81F3\u5E15\u9C81\u7BB1\u5B50\uFF0C\r\n\u53EA\u8981\u5EFA\u9020\u5E15\u9C81\u7EC8\u7AEF\u5C31\u80FD\u628A\u5B83\u4EEC\u653E\u51FA\u6765\u3002",
    "Help_6": "HUD\r\n\r\n\u5DE6\u4E0B\u65B9\u4F1A\u663E\u793A\u961F\u4F0D\u91CC\u7684\u5E15\u9C81\u548C\u73A9\u5BB6\u7684\u751F\u547D\u503C\u4EE5\u53CA\u9971\u8179\u5EA6\u3002\r\n\u5728\u5176\u53F3\u8FB9\u4F1A\u663E\u793A\u5F53\u524D\u6C14\u6E29\uFF0C\u5728\u9AD8\u6E29\uFF0F\u4F4E\u6E29\u73AF\u5883\u4E0B\u4F1A\u53D7\u5230\u4F24\u5BB3\u3002\r\n\u53F3\u4E0B\u65B9\u663E\u793A\u7684\u5219\u662F\u76EE\u524D\u88C5\u5907\u7684\u5E15\u9C81\u7403\u548C\u6B66\u5668\uFF0C\u4EE5\u53CA\u5269\u4F59\u5B50\u5F39\u91CF\u3002",
    "Help_7": "\u5982\u4F55\u83B7\u5F97\u9053\u5177\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|Interact_1|/\u003E\u5373\u53EF\u6361\u8D77\u6389\u5728\u5730\u4E0A\u7684\u9053\u5177\u3002\r\n\u7528\u65A7\u5934\u3001\u5341\u5B57\u9550\u7834\u574F\u6811\u6728\u4E0E\u5CA9\u77F3\u7B49\u4E5F\u80FD\u53D6\u5F97\u7D20\u6750\u3002\r\n\u6253\u5012\u5E15\u9C81\u65F6\u4E5F\u80FD\u53D6\u5F97\u5E15\u9C81\u6389\u843D\u7684\u9053\u5177\u3002",
    "Help_8": "\u5EFA\u9020\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|OpenConstructionMenu|/\u003E\u5373\u53EF\u6253\u5F00\u5EFA\u9020\u83DC\u5355\u8FDB\u884C\u5EFA\u9020\u3002\r\n\u901A\u8FC7\u5EFA\u9020\u83DC\u5355\u9009\u62E9\u5E76\u51B3\u5B9A\u5EFA\u9020\u5730\u70B9\u540E\uFF0C\u5728\u8A72\u5730\u70B9\u9577\u6309\u003CkeyGuideIcon id=|Interact_1|/\u003E\u5F00\u59CB\u5DE5\u4F5C\u5373\u53EF\u5B8C\u6210\u5EFA\u9020\u3002\r\n\u5982\u679C\u961F\u4F0D\u6216\u636E\u70B9\u91CC\u6709\u5E15\u9C81\uFF0C\u4E5F\u80FD\u627E\u5B83\u4EEC\u6765\u534F\u52A9\u5EFA\u9020\u3002",
    "Help_9": "\u5236\u4F5C\r\n\r\n\u5EFA\u9020\u5DE5\u4F5C\u53F0\u7B49\u540E\uFF0C\u5C31\u53EF\u4EE5\u5F00\u59CB\u5236\u4F5C\u9053\u5177\u3002\r\n\u73A9\u5BB6\u53EF\u4F7F\u7528\u79D1\u6280\u70B9\u6765\u89E3\u9501\u65B0\u7684\u914D\u65B9\u6216\u5EFA\u9020\u5176\u4ED6\u5DE5\u4F5C\u8BBE\u65BD\uFF0C\r\n\u7136\u540E\u5C31\u80FD\u5236\u4F5C\u65B0\u7684\u9053\u5177\u3002",
    "Help_10": "\u79D1\u6280\r\n\r\n\u6253\u5F00\u83DC\u5355\u4E2D\u7684\u300C\u79D1\u6280\u300D\u5206\u9875\u5E76\u4F7F\u7528\u79D1\u6280\u70B9\uFF0C\r\n\u5C31\u80FD\u89E3\u9501\u65B0\u7684\u5EFA\u7B51\u6216\u9053\u5177\u914D\u65B9\u3002\r\n\u5347\u7EA7\u6216\u89E3\u9501\u5DE8\u9E6B\u4E4B\u50CF\u7B49\u4FBF\u53EF\u83B7\u5F97\u79D1\u6280\u70B9\u3002",
    "Help_11": "\u53E4\u4EE3\u79D1\u6280\r\n\r\n\u6253\u5012\u5F3A\u5927\u7684\u654C\u4EBA\u5C06\u53EF\u83B7\u5F97\u53E4\u4EE3\u79D1\u6280\u70B9\uFF0C\r\n\u4F7F\u7528\u5B83\u4FBF\u53EF\u89E3\u9501\u53E4\u4EE3\u6280\u672F\u3002\r\n\r\n\u53E4\u4EE3\u6280\u672F\u662F\u5DF2\u6D88\u4EA1\u7684\u6587\u660E\u53D1\u5C55\u51FA\u7684\u5148\u8FDB\u6280\u672F\uFF0C\r\n\u5176\u6548\u679C\u901A\u5E38\u65E2\u5F3A\u529B\u53C8\u72EC\u7279\u3002",
    "Help_12": "\u7B49\u7EA7\r\n\r\n\u5F53\u73A9\u5BB6\u548C\u5E15\u9C81\u83B7\u5F97\u4E00\u5B9A\u7ECF\u9A8C\u503C\u540E\uFF0C\u5C31\u53EF\u4EE5\u5347\u7EA7\u3002\r\n\u8BA8\u4F10\u6216\u6355\u83B7\u5E15\u9C81\u7686\u53EF\u83B7\u5F97\u7ECF\u9A8C\u503C\u3002\r\n\u6B64\u5916\uFF0C\u5EFA\u9020\u548C\u5236\u4F5C\u65F6\u4E5F\u80FD\u6839\u636E\u5DE5\u4F5C\u91CF\u83B7\u5F97\u7ECF\u9A8C\u3002\r\n\r\n\u73A9\u5BB6\u65E0\u6CD5\u64CD\u63A7\u7B49\u7EA7\u6BD4\u81EA\u5DF1\u9AD8\u7684\u5E15\u9C81\uFF0C\r\n\u6B64\u65F6\u7B49\u7EA7\u540C\u6B65\u673A\u5236\u4F1A\u751F\u6548\uFF0C\u4F7F\u5B83\u7684\u80FD\u529B\u964D\u4F4E\u81F3\u4E0E\u73A9\u5BB6\u76F8\u540C\u7B49\u7EA7\u3002",
    "Help_13": "\u5F3A\u5316\u73A9\u5BB6\u80FD\u529B\u503C\r\n\r\n\u6253\u5F00\u83DC\u5355\u300C\u7269\u54C1\u680F\u300D\u5206\u9875\u5E76\u5206\u914D\u5C5E\u6027\u70B9\uFF0C\r\n\u5373\u53EF\u63D0\u5347\u73A9\u5BB6\u672C\u8EAB\u7684\u5404\u9879\u6570\u503C\u3002\r\n\u63D0\u5347\u73A9\u5BB6\u7684\u7B49\u7EA7\u4FBF\u53EF\u83B7\u5F97\u5C5E\u6027\u70B9\u3002",
    "Help_14": "\u636E\u70B9\r\n\r\n\u5F53\u5EFA\u9020\u5E15\u9C81\u7EC8\u7AEF\u540E\uFF0C\u5176\u5468\u8FB9\u533A\u57DF\u5C31\u4F1A\u88AB\u8BA4\u5B9A\u4E3A\u636E\u70B9\u3002\r\n\u5229\u7528\u5E15\u9C81\u7EC8\u7AEF\u7684\u529F\u80FD\u5373\u53EF\u5C06\u5E15\u9C81\u53EC\u5524\u5230\u636E\u70B9\u91CC\u3002\r\n\u5F53\u5E15\u9C81\u6765\u5230\u636E\u70B9\u540E\uFF0C\u4F1A\u6839\u636E\u81EA\u5DF1\u7684\u5DE5\u4F5C\u9002\u5E94\u6027\u4E3B\u52A8\u5F00\u59CB\u5DE5\u4F5C\u3002\r\n\r\n\u5728\u636E\u70B9\u91CC\u5EFA\u9020\u5EFA\u7B51\u7684\u65F6\u5019\uFF0C\u53EF\u4EE5\u8BA9\u5E15\u9C81\u4E00\u8D77\u534F\u52A9\u5DE5\u4F5C\u3002\r\n\u4F46\u4F4D\u4E8E\u636E\u70B9\u5185\u7684\u5E15\u9C81\u4E5F\u5C06\u9762\u4E34\u5916\u654C\u7684\u5A01\u80C1\uFF0C\u4E0D\u80FD\u6389\u4EE5\u8F7B\u5FC3\u3002",
    "Help_15": "\u5E15\u9C81\u7EC8\u7AEF\r\n\r\n\u5E15\u9C81\u7EC8\u7AEF\u5468\u8FB9\u7684\u4E00\u5B9A\u8303\u56F4\u5C06\u6210\u4E3A\u4F60\u76EE\u524D\u516C\u4F1A\u7684\u636E\u70B9\u9886\u5730\uFF0C\u4F4D\u4E8E\u9886\u5730\u4E0A\u7684\u5EFA\u7B51\u4E5F\u5C06\u6210\u4E3A\u8BE5\u516C\u4F1A\u7684\u6240\u6709\u7269\u3002\r\n\u5229\u7528\u5E15\u9C81\u7EC8\u7AEF\u7684\u529F\u80FD\u5373\u53EF\u786E\u8BA4\u300C\u4EFB\u52A1\u300D\u5185\u5BB9\uFF0C\u5B8C\u6210\u4EFB\u52A1\u4FBF\u80FD\u8BA9\u516C\u4F1A\u636E\u70B9\u66F4\u8FDB\u4E00\u6B65\u53D1\u5C55\uFF0C\u5E76\u589E\u52A0\u53EF\u53EC\u5524\u81F3\u636E\u70B9\u7684\u5E15\u9C81\u6570\u91CF\u3002\r\n\r\n\u5C06\u5E15\u9C81\u653E\u5165\u5E15\u9C81\u7BB1\u5185\uFF0C\u5C31\u80FD\u8BA9\u5B83\u4EEC\u4F11\u606F\u5E76\u6062\u590D\u751F\u547D\u503C\u3002\r\n\u6B64\u6062\u590D\u529F\u80FD\u5BF9\u9677\u5165\u6FD2\u6B7B\u72B6\u51B5\u7684\u5E15\u9C81\u540C\u6837\u6709\u6548\u3002\r\n\r\n\u5E15\u9C81\u7EC8\u7AEF\u9644\u6709\u5FEB\u901F\u4F20\u9001\u529F\u80FD\uFF0C\u53EF\u4EE5\u8BA9\u73A9\u5BB6\u77AC\u95F4\u79FB\u52A8\u81F3\u5192\u9669\u9014\u4E2D\u5DF2\u89E3\u9501\u8FC7\u7684\u5DE8\u9E6B\u4E4B\u50CF\u6240\u5728\u5730\u3002\r\n\u203B\u9700\u5728\u4E16\u754C\u8BBE\u7F6E\u4E2D\u542F\u7528\u5FEB\u901F\u4F20\u9001\uFF0C\u624D\u80FD\u4F7F\u7528\u5FEB\u901F\u4F20\u9001\u529F\u80FD\u3002",
    "Help_16": "\u6355\u83B7\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|ThrowObject|/\u003E\u5373\u53EF\u4E22\u51FA\u5E15\u9C81\u7403\uFF0C\u4E22\u4E2D\u5E15\u9C81\u4FBF\u53EF\u5C1D\u8BD5\u5C06\u5176\u6355\u83B7\u3002\r\n\u751F\u547D\u503C\u4E0B\u964D\u3001\u5904\u4E8E\u5F02\u5E38\u72B6\u6001\u6216\u843D\u5165\u9677\u9631\u4E4B\u4E2D\u7684\u5E15\u9C81\u8F83\u5BB9\u6613\u6355\u83B7\u3002\r\n\u53E6\u5916\u4E5F\u53EF\u8D81\u5E15\u9C81\u4E0D\u6CE8\u610F\u65F6\u4ECE\u540E\u65B9\u4E22\u51FA\u5E15\u9C81\u7403\uFF0C\u63D0\u9AD8\u6210\u529F\u6355\u83B7\u7684\u673A\u7387\u3002\r\n\u5236\u4F5C\u66F4\u5F3A\u7684\u5E15\u9C81\u7403\uFF0C\u5C31\u80FD\u6355\u83B7\u66F4\u5F3A\u7684\u5E15\u9C81\u3002",
    "Help_17": "\u961F\u4F0D\u4E2D\u7684\u5E15\u9C81\r\n\r\n\u4F60\u53EF\u4EE5\u540C\u65F6\u643A\u5E26\u7684\u5E15\u9C81\u6570\u91CF\u6700\u591A\u4E3A5\u53EA\uFF0C\u5982\u679C\u6355\u83B7\u4E866\u53EA\u6216\u66F4\u591A\uFF0C\u591A\u4F59\u7684\u5E15\u9C81\u5C06\u4F1A\u88AB\u81EA\u52A8\u9001\u81F3\u5E15\u9C81\u7BB1\u3002\r\n\u4F60\u643A\u5E26\u7684\u8FD9\u6700\u591A5\u53EA\u5E15\u9C81\u5C31\u7EC4\u6210\u4E86\u4F60\u7684\u961F\u4F0D\u3002\r\n\r\n\u6253\u5F00\u83DC\u5355\u540E\u5373\u53EF\u6253\u5F00\u300C\u961F\u4F0D\u300D\u5206\u9875\uFF0C\r\n\u786E\u8BA4\u961F\u4F0D\u5185\u5E15\u9C81\u7684\u751F\u547D\u503C\u53CA\u9971\u8179\u5EA6\u7B49\u6570\u503C\u3002\r\n\u6B64\u5916\uFF0C\u8FD8\u53EF\u4EE5\u67E5\u770B\u5E15\u9C81\u76EE\u524D\u5B66\u4F1A\u7684\u6280\u80FD\uFF0C\r\n\u5E76\u66FF\u6362\u5E15\u9C81\u5DF2\u5B66\u4F1A\u7684\u4E3B\u52A8\u6280\u80FD\u7B49\u3002",
    "Help_18": "\u9971\u8179\u5EA6\r\n\r\n\u73A9\u5BB6\u4E0E\u5E15\u9C81\u7684\u6D3B\u52A8\u4F1A\u5BFC\u81F4\u9971\u8179\u5EA6\u964D\u4F4E\u3002\r\n\u9971\u8179\u5EA6\u964D\u4F4E\u4F1A\u9020\u6210\u6570\u503C\u964D\u4F4E\u7B49\u4E00\u7CFB\u5217\u8D1F\u9762\u5F71\u54CD\u3002\r\n\r\n\u6253\u5F00\u7269\u54C1\u680F\u4F7F\u7528\u98DF\u7269\u7C7B\u9053\u5177\uFF0C\r\n\u5373\u53EF\u6062\u590D\u73A9\u5BB6\u548C\u5E15\u9C81\u7684\u9971\u8179\u5EA6\u3002",
    "Help_19": "SAN\u503C\r\n\r\n\u5728\u636E\u70B9\u5DE5\u4F5C\u4F1A\u5BFC\u81F4\u5E15\u9C81\u7684SAN\u503C\u964D\u4F4E\u3002\r\nSAN\u503C\u964D\u4F4E\u4F1A\u5BFC\u81F4\u5E15\u9C81\u5077\u61D2\u6216\u751F\u75C5\u3002\r\n\u4E14\u9971\u8179\u5EA6\u964D\u4F4E\u65F6\uFF0CSAN\u503C\u964D\u4F4E\u7684\u901F\u5EA6\u4F1A\u66F4\u5FEB\u3002\r\n\u5582\u7ED9\u5B83\u4EEC\u7F8E\u5473\u7684\u98DF\u7269\u6216\u662F\u8BA9\u5B83\u4EEC\u5230\u6E29\u6CC9\u4F11\u606F\uFF0C\u5373\u53EF\u6062\u590D\u5B83\u4EEC\u7684SAN\u503C\u3002",
    "Help_20": "\u4F19\u4F34\u6280\u80FD\r\n\r\n\u5E15\u9C81\u7684\u56FA\u6709\u80FD\u529B\uFF0C\u4F9D\u5176\u79CD\u65CF\u6709\u6240\u4E0D\u540C\u3002\r\n\u4F19\u4F34\u6280\u80FD\u6548\u679C\u5305\u542B\u53EF\u8BA9\u73A9\u5BB6\u9A91\u4E58\u5E15\u9C81\uFF0C\u6216\u8BA9\u5E15\u9C81\u80FD\u591F\u6301\u67AA\u5C04\u51FB\u7B49\u3002\r\n\r\n\u90E8\u5206\u5E15\u9C81\u60F3\u8981\u89E3\u9501\u4F19\u4F34\u6280\u80FD\uFF0C\u9700\u8981\u5148\u5728\u5E15\u9C81\u88C5\u5907\u5DE5\u4F5C\u53F0\u4E0A\u5236\u4F5C\u51FA\u300C\u5E15\u9C81\u88C5\u5907\u300D\u3002\r\n\r\n\u4E5F\u6709\u90E8\u5206\u5E15\u9C81\u53EA\u8981\u5728\u961F\u4F0D\u91CC\u5C31\u80FD\u53D1\u52A8\u4F19\u4F34\u6280\u80FD\u6548\u679C\u3002\u6253\u5F00\u961F\u4F0D\u753B\u9762\u5373\u53EF\u67E5\u770B\u4F19\u4F34\u6280\u80FD\u7684\u6548\u679C\u3002",
    "Help_21": "\u5E15\u9C81\u56FE\u9274\r\n\r\n\u53EF\u901A\u8FC7\u83DC\u5355\u6253\u5F00\u5E15\u9C81\u56FE\u9274\u3002\r\n\u56FE\u9274\u4F1A\u81EA\u52A8\u8BB0\u5F55\u66FE\u76EE\u51FB\u6216\u6355\u83B7\u7684\u5E15\u9C81\u4FE1\u606F\u3002\r\n\u67E5\u770B\u56FE\u9274\u5373\u53EF\u786E\u8BA4\u5176\u6816\u606F\u5730\u7B49\u4FE1\u606F\u3002",
    "Help_22": "\u56FE\u9274\u5956\u52B1\r\n\r\n\u5F53\u6355\u83B7\u65B0\u54C1\u79CD\u7684\u5E15\u9C81\u65F6\uFF0C\u73A9\u5BB6\u4F1A\u83B7\u5F97\u7ECF\u9A8C\u503C\u5956\u52B1\u3002\r\n\u5E76\u4E14\u5728\u6293\u523012\u53EA\u8BE5\u79CD\u65CF\u5E15\u9C81\u524D\uFF0C\u6BCF\u6B21\u6355\u83B7\u90FD\u53EF\u4EE5\u83B7\u5F97\u7ECF\u9A8C\u503C\u5956\u52B1\u3002",
    "Help_23": "\u516C\u4F1A\r\n\r\n\u63A5\u8FD1\u5176\u4ED6\u73A9\u5BB6\u5373\u53EF\u7533\u8BF7\u52A0\u5165\u5BF9\u65B9\u7684\u516C\u4F1A\u3002\r\n\u6253\u5F00\u83DC\u5355\u540E\u53EF\u70B9\u9009\u516C\u4F1A\u5206\u9875\uFF0C\r\n\u8BE5\u5206\u9875\u5185\u4F1A\u663E\u793A\u5F53\u524D\u52A0\u5165\u7684\u516C\u4F1A\u4FE1\u606F\uFF0C\u5E76\u53EF\u67E5\u770B\u516C\u4F1A\u6210\u5458\u7684\u72B6\u6001\u3002\r\n\u540C\u4E00\u516C\u4F1A\u7684\u73A9\u5BB6\u5C06\u5171\u4EAB\u636E\u70B9\uFF0C\r\n\u5E76\u53EF\u81EA\u7531\u5171\u4EAB\u3001\u5206\u6D3E\u4E8E\u636E\u70B9\u5185\u5DE5\u4F5C\u7684\u5E15\u9C81\u3002",
    "Help_24": "\u5730\u56FE\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|OpenWorldMap|/\u003E\u5373\u53EF\u6253\u5F00\u5730\u56FE\u3002\r\n\u5730\u56FE\u4E0A\u4F1A\u6807\u793A\u5404\u533A\u57DF\u7684\u4FE1\u606F\u7B49\u3002",
    "Help_25": "\u5DE8\u9E6B\u4E4B\u50CF\r\n\r\n\u4E0E\u4E4B\u4E92\u52A8\u5373\u53EF\u89E3\u9501\uFF0C\r\n\u5E76\u53EF\u5FEB\u901F\u4F20\u9001\u81F3\u5176\u4ED6\u5DE8\u9E6B\u4E4B\u50CF\u6216\u81EA\u5DF1\u7684\u5E15\u9C81\u7EC8\u7AEF\u7684\u6240\u5728\u5730\u3002\r\n\r\n\u6B64\u5916\uFF0C\u89E3\u9501\u5DE8\u9E6B\u4E4B\u50CF\u65F6\u8FD8\u4F1A\u83B7\u5F97\u79D1\u6280\u70B9\u3002\r\n\u5DE8\u9E6B\u4E4B\u50CF\u904D\u5E03\u4E8E\u4E16\u754C\u5404\u5730\uFF0C\u5192\u9669\u65F6\u522B\u5FD8\u4E86\u627E\u627E\u5B83\u7684\u8E2A\u8FF9\u3002\r\n\r\n\u203B\u9700\u5728\u4E16\u754C\u8BBE\u7F6E\u4E2D\u542F\u7528\u5FEB\u901F\u4F20\u9001\uFF0C\u624D\u80FD\u4F7F\u7528\u5FEB\u901F\u4F20\u9001\u529F\u80FD\u3002",
    "Help_26": "\u73AF\u5F62\u83DC\u5355\r\n\r\n\u6309\u4E0B\u003CkeyGuideIcon id=|PartnerPalInstructions|/\u003E\u952E\u540E\u5373\u53EF\u53EB\u51FA\u8FD9\u4E2A\u83DC\u5355\u3002\r\n\u901A\u8FC7\u6B64\u83DC\u5355\u53EF\u5BF9\u961F\u4F0D\u5185\u7684\u5E15\u9C81\u4E0B\u8FBE\u4F5C\u6218\u547D\u4EE4\uFF0C\u6216\u5582\u9972\u6599\u7ED9\u961F\u4F0D\u5185\u7684\u5E15\u9C81\u5403\u7B49\u3002",
    "Help_27": "\u5173\u4E8E\u591C\u665A\r\n\r\n\u591C\u665A\u4F1A\u968F\u7740\u65F6\u95F4\u7684\u6D41\u901D\u5230\u6765\uFF0C\u5C4A\u65F6\u56DB\u5468\u4F1A\u53D8\u6697\u3001\u6C14\u6E29\u4E0B\u964D\uFF0C\u591C\u884C\u6027\u7684\u5371\u9669\u5E15\u9C81\u4E5F\u4F1A\u5F00\u59CB\u51FA\u6CA1\u3002\r\n\u548C\u5927\u5BB6\u4E00\u8D77\u5F85\u5728\u5B89\u5168\u7684\u5730\u70B9\u56F4\u7740\u8425\u706B\u53D6\u6696\uFF0C\u6216\u8005\u5EFA\u9020\u5E8A\u4E00\u89C9\u7761\u5230\u5929\u4EAE\u4F1A\u662F\u6BD4\u8F83\u5B89\u5168\u7684\u505A\u6CD5\u3002",
    "Help_28": "\u9AD8\u5854\u5934\u76EE\r\n\r\n\u6BCF\u4E2A\u533A\u57DF\u90FD\u77D7\u7ACB\u7740\u4E00\u5EA7\u9AD8\u5854\uFF0C\u7531\u63A7\u5236\u8BE5\u5730\u533A\u7684\u7EC4\u7EC7\u9996\u9886\u8D1F\u8D23\u5B88\u536B\u3002\r\n\u4ED6\u4EEC\u901A\u5E38\u5BF9\u6765\u81EA\u5C9B\u5916\u7684\u5E15\u9C81\u8BAD\u7EC3\u5BB6\u62B1\u6709\u654C\u610F\uFF0C\u4E00\u65E6\u8FDB\u5165\u5854\u5185\u4FBF\u4F1A\u7ACB\u5373\u6218\u6597\u3002\r\n\u5854\u5185\u7684\u5934\u76EE\u6218\u6709\u65F6\u95F4\u9650\u5236\uFF0C\u672A\u80FD\u5728\u89C4\u5B9A\u65F6\u95F4\u5185\u51FB\u8D25\u654C\u4EBA\u5373\u7B97\u5931\u8D25\u3002\r\n\u4F46\u53EA\u8981\u6CA1\u6709\u5176\u4ED6\u4EBA\u6B63\u5728\u6311\u6218\uFF0C\u4FBF\u53EF\u4EE5\u65E0\u9650\u6B21\u5C1D\u8BD5\u3002",
    "Help_29": "\u72AF\u7F6A\r\n\r\n\u82E5\u653B\u51FB\u91CE\u5916\u6216\u6751\u5B50\u91CC\u7684\u5584\u826FNPC\uFF0C\u5C31\u4F1A\u88AB\u68C0\u4E3E\u5E76\u5217\u4E3A\u72AF\u7F6A\u5206\u5B50\u3002\r\n\u6B64\u5916\uFF0C\u8E0F\u8FDB\u7981\u6B62\u8FDB\u5165\u7684\u90E8\u5206\u5C9B\u5C7F\u4E5F\u4F1A\u8BA9\u4F60\u88AB\u89C6\u4E3A\u72AF\u7F6A\u5206\u5B50\u3002\r\n\u72AF\u7F6A\u884C\u4E3A\u4E00\u65E6\u88AB\u4EBA\u53D1\u73B0\uFF0C\u5C31\u4F1A\u906D\u5E15\u6D1B\u65AF\u7FA4\u5C9B\u81EA\u536B\u961F\u901A\u7F09\uFF0C\u8BF7\u52A1\u5FC5\u6CE8\u610F\u3002",
    "Help_30": "\u88C5\u5907\u7684\u8010\u4E45\u503C\r\n\r\n\u4F7F\u7528\u88C5\u5907\u4F1A\u4F7F\u5176\u8010\u4E45\u503C\u964D\u4F4E\uFF0C\u800C\u8010\u4E45\u503C\u5F52\u96F6\u65F6\u88C5\u5907\u4FBF\u4F1A\u635F\u574F\u3002\r\n\u5728\u4FEE\u7406\u53F0\u4F7F\u7528\u7D20\u6750\u5C31\u53EF\u4EE5\u4FEE\u7406\u8010\u4E45\u503C\u964D\u4F4E\u7684\u88C5\u5907\u3002",
    "Help_31": "\u9053\u5177\u7684\u8150\u8D25\u673A\u5236\r\n\r\n\u98DF\u7269\u7B49\u90E8\u5206\u9053\u5177\u4F1A\u4F34\u968F\u7740\u65F6\u95F4\u6D41\u901D\u800C\u8150\u70C2\uFF0C\u8150\u70C2\u7684\u9053\u5177\u4F1A\u76F4\u63A5\u6D88\u5931\u3002\r\n\u5C06\u8FD9\u7C7B\u9053\u5177\u653E\u8FDB\u4FDD\u51B7\u7BB1\u6216\u51B0\u7BB1\u7B49\u5C31\u53EF\u4EE5\u6291\u5236\u8150\u70C2\u3002",
    "Help_32": "\u5C5E\u6027\r\n\r\n\u6BCF\u53EA\u5E15\u9C81\u90FD\u6709\u76F8\u5E94\u7684\u5C5E\u6027\uFF0C\u6BCF\u79CD\u5C5E\u6027\u5747\u6709\u5404\u81EA\u7684\u4F18\u52BF\u5C5E\u6027\u4E0E\u5F31\u70B9\u5C5E\u6027\u3002\r\n\u653B\u51FB\u4F18\u52BF\u5C5E\u6027\u7684\u5E15\u9C81\u53EF\u4EE5\u9020\u6210\u66F4\u591A\u4F24\u5BB3\uFF0C\u800C\u653B\u51FB\u5F31\u70B9\u5C5E\u6027\u7684\u5E15\u9C81\u9020\u6210\u7684\u4F24\u5BB3\u4F1A\u8F83\u5C11\u3002",
    "Help_33": "\u5F02\u5E38\u72B6\u6001\r\n\r\n\u5E15\u9C81\u548C\u73A9\u5BB6\u4F1A\u56E0\u4E3A\u5468\u56F4\u7684\u73AF\u5883\u4EE5\u53CA\u6280\u80FD\u6548\u679C\u800C\u9677\u5165\u5F02\u5E38\u72B6\u6001\u3002\r\n\u5F02\u5E38\u72B6\u6001\u53EF\u80FD\u4F1A\u5BFC\u81F4\u79FB\u52A8\u901F\u5EA6\u51CF\u7F13\uFF0C\u6216\u5BF9\u5E15\u9C81\u4E0E\u73A9\u5BB6\u9020\u6210\u6301\u7EED\u4F24\u5BB3\u3002\r\n\u9677\u5165\u5F02\u5E38\u72B6\u6001\u7684\u5E15\u9C81\u4F1A\u5BB9\u6613\u6355\u83B7\u3002",
    "Help_34": "\u5E15\u9C81\u86CB\r\n\r\n\u5728\u91CE\u5916\u63A2\u7D22\u65F6\uFF0C\u6709\u65F6\u80FD\u591F\u627E\u5230\u5E15\u9C81\u86CB\u3002\r\n\u5C06\u5E15\u9C81\u86CB\u7F6E\u4E8E\u5E15\u9C81\u86CB\u5B75\u5316\u5668\uFF0C\u5C31\u80FD\u4F7F\u4E4B\u5B75\u5316\u3002\r\n\u5C06\u5468\u56F4\u8C03\u8282\u81F3\u76F8\u5E94\u4E14\u9002\u5408\u7684\u6E29\u5EA6\u5373\u53EF\u52A0\u5FEB\u5B75\u5316\u7684\u901F\u5EA6\u3002",
    "Help_35": "\u5E15\u9C81\u914D\u79CD\u7267\u573A\r\n\r\n\u5C06\u96CC\u6027\u4E0E\u96C4\u6027\u7684\u5E15\u9C81\u5206\u6D3E\u81F3\u914D\u79CD\u7267\u573A\uFF0C\u5E76\u5728\u7267\u573A\u5185\u653E\u7F6E\u86CB\u7CD5\uFF0C\r\n\u5C31\u6709\u673A\u4F1A\u83B7\u5F97\u5E15\u9C81\u86CB\u3002\r\n\u67D0\u4E9B\u7279\u6B8A\u7684\u5E15\u9C81\u7EC4\u5408\u5C06\u4F1A\u751F\u4E0B\u7279\u6B8A\u7684\u5E15\u9C81\u86CB\u3002",
    "Help_36": "\u5E15\u9C81\u9636\u7EA7\u4E0E\u6D53\u7F29\u673A\r\n\r\n\u6BCF\u53EA\u5E15\u9C81\u90FD\u6709\u5404\u81EA\u7684\u9636\u7EA7\uFF0C\u9636\u7EA7\u8D8A\u9AD8\uFF0C\u5176\u7D20\u8D28\u4E5F\u8D8A\u9AD8\u3002\r\n\u5E76\u4E14\u90E8\u5206\u5E15\u9C81\u7684\u9636\u7EA7\u8D8A\u9AD8\uFF0C\u5176\u4F19\u4F34\u6280\u80FD\u7684\u6548\u679C\u8D8A\u5F3A\u3002\r\n\u73A9\u5BB6\u53EF\u901A\u8FC7\u6D53\u7F29\u673A\u8BBE\u65BD\u6765\u63D0\u5347\u5E15\u9C81\u7684\u9636\u7EA7\uFF0C\u4F46\u9700\u5148\u7528\u6D53\u7F29\u673A\u5C06\u5927\u91CF\u7684\u540C\u54C1\u79CD\u5E15\u9C81\u6D53\u7F29\u6210\u7CBE\u534E\u3002",
    "Help_37": "\u7FE0\u53F6\u9F20\u96D5\u50CF\r\n\r\n\u5C06\u5728\u91CE\u5916\u627E\u5230\u7684\u7FE0\u53F6\u9F20\u96D5\u50CF\u732E\u7ED9\u529B\u91CF\u77F3\u50CF\uFF0C\r\n\u4FBF\u80FD\u5F3A\u5316\u73A9\u5BB6\u7684\u529B\u91CF\uFF0C\u63D0\u9AD8\u73A9\u5BB6\u6355\u83B7\u5E15\u9C81\u7684\u80FD\u529B\u3002",
    "Help_38": "\u5E15\u9C81\u4E4B\u9B42\r\n\r\n\u5C06\u4ECE\u5B9D\u7BB1\u7B49\u627E\u5230\u7684\u5E15\u9C81\u4E4B\u9B42\u732E\u7ED9\u529B\u91CF\u77F3\u50CF\uFF0C\r\n\u4FBF\u80FD\u5F3A\u5316\u5E15\u9C81\u7684\u529B\u91CF\uFF0C\u63D0\u9AD8\u5E15\u9C81\u7684\u80FD\u529B\u503C\u3002",
    "Help_39": "\u5E15\u9C81\u7684\u4E9A\u79CD\r\n\r\n\u6839\u636E\u89C2\u5BDF\u53D1\u73B0\uFF0C\u6709\u4E00\u90E8\u5206\u5E15\u9C81\u4E3A\u4E86\u9002\u5E94\u6816\u606F\u5730\u7684\u73AF\u5883\u800C\u8FDB\u5316\u51FA\u4E86\u4E0D\u540C\u7684\u5F62\u6001\uFF0C\u88AB\u79F0\u4E3A\u300C\u4E9A\u79CD\u300D\u3002\r\n\u4E9A\u79CD\u76F8\u8F83\u4E8E\u539F\u79CD\u6709\u7740\u4E0D\u4E00\u6837\u7684\u5C5E\u6027\uFF0C\u4E14\u5176\u7D20\u8D28\u4E5F\u4F1A\u7A0D\u5FAE\u9AD8\u51FA\u4E00\u4E9B\u3002\r\n\r\n\u6B64\u5916\uFF0C\u5728\u5C06\u5E15\u9C81\u8FDB\u884C\u914D\u79CD\u7684\u65F6\u5019\u6709\u53EF\u80FD\u4F1A\u751F\u51FA\u4E9A\u79CD\u3002\r\n\r\n\u4E9A\u79CD\u7684\u56FE\u9274\u5956\u52B1\u662F\u4E0E\u539F\u79CD\u5206\u5F00\u8BA1\u7B97\u7684\uFF0C\u56E0\u6B64\u5728\u6355\u83B7\u524D12\u53EA\u4E9A\u79CD\u65F6\u540C\u6837\u4E5F\u80FD\u83B7\u5F97\u66F4\u591A\u7ECF\u9A8C\u503C\u3002",
    "Help_40": "\u5E78\u8FD0\u5E15\u9C81\r\n\r\n\u6709\u65F6\u80FD\u5728\u91CE\u5916\u53D1\u73B0\u88AB\u79F0\u4E3A\u5E78\u8FD0\u5E15\u9C81\u7684\u8D85\u7A00\u6709\u5E15\u9C81\u3002\r\n\u8FD9\u79CD\u5E15\u9C81\u7684\u7279\u5F81\u662F\u4F53\u578B\u8F83\u5927\uFF0C\u5E76\u4E14\u8EAB\u4E0A\u4F1A\u6563\u53D1\u51FA\u5149\u8292\u3002\r\n\u5B83\u4EEC\u5927\u591A\u90FD\u6709\u7279\u6B8A\u7684\u88AB\u52A8\u6280\u80FD\u548C\u4E3B\u52A8\u6280\u80FD\uFF0C\u5E76\u4E14\u80FD\u529B\u503C\u901A\u5E38\u4E5F\u8F83\u9AD8\u3002",
    "Help_40_2": "\u6355\u98DF\u8005\u5E15\u9C81\r\n\r\n\u6709\u65F6\u80FD\u5728\u91CE\u5916\u53D1\u73B0\u79F0\u4E3A\u300C\u6355\u98DF\u8005\u5E15\u9C81\u300D\u7684\u51F6\u731B\u5E15\u9C81\u3002\r\n\u8FD9\u79CD\u5E15\u9C81\u7684\u7279\u5F81\u662F\u4F53\u578B\u5DE8\u5927\uFF0C\u5168\u8EAB\u6563\u53D1\u7740\u6697\u7EA2\u8272\u7684\u6C14\u606F\uFF0C\u6027\u60C5\u6781\u4E3A\u51F6\u731B\u3002\r\n\u56E0\u4E3A\u53D7\u5230\u9ED1\u6697\u6C14\u573A\u7684\u4FDD\u62A4\uFF0C\u6355\u98DF\u8005\u5E15\u9C81\u65E0\u6CD5\u88AB\u5E15\u9C81\u7403\u6355\u6349\u3002\r\n\u5728\u8FDB\u884C\u6311\u6218\u4E4B\u524D\uFF0C\u8BF7\u786E\u4FDD\u4F60\u6709\u8DB3\u591F\u7684\u6218\u529B\u3002",
    "Help_41": "\u6B7B\u4EA1\u60E9\u7F5A\u673A\u5236\r\n\r\n\u73A9\u5BB6\u6B7B\u4EA1\u65F6\uFF0C\u6301\u6709\u7684\u9053\u5177\u4E0E\u5E15\u9C81\u5C06\u4F1A\u6389\u843D\u5728\u6B7B\u4EA1\u5730\u70B9\u3002\r\n\u590D\u6D3B\u540E\u518D\u6B21\u56DE\u5230\u8BE5\u5730\u5373\u53EF\u6361\u56DE\u6389\u843D\u7269\u3002\r\n\u6B64\u5916\uFF0C\u5728\u4E0A\u7A7A\u4E5F\u53EF\u89E6\u6478\u6B7B\u4EA1\u65F6\u4EA7\u751F\u7684\u5149\u67F1\uFF0C\u53EF\u4EE5\u901A\u8FC7\u8FD9\u79CD\u65B9\u5F0F\u56DE\u6536\u5E15\u9C81\u548C\u9053\u5177\u3002\r\n\r\n\u203B\u53EF\u5728\u4E16\u754C\u8BBE\u7F6E\u4E2D\u8C03\u6574\u60E9\u7F5A\u673A\u5236\u7684\u6709\u65E0\u53CA\u5176\u5185\u5BB9\u3002",
    "Help_42": "\u7ADE\u6280\u573A\r\n\r\n\u7ADE\u6280\u573A\u662F\u4F4D\u4E8E\u6C99\u6F20\u5730\u533A\u67D0\u5EA7\u5B64\u5C9B\u4E0A\u7684\u8BBE\u65BD\u3002\r\n\u5728\u8FD9\u91CC\uFF0C\u4F60\u53EF\u4EE5\u4E0E\u81EA\u5DF1\u7CBE\u5FC3\u57F9\u517B\u7684\u5E15\u9C81\u5E76\u80A9\u4F5C\u6218\uFF0C\u8DDF\u540C\u4E00\u4E16\u754C\u5185\u7684\u5176\u4ED6\u5E15\u9C81\u8BAD\u7EC3\u5BB6\u4E00\u8F83\u9AD8\u4E0B\u3002\r\n\u9664\u6B64\u4E4B\u5916\uFF0C\u4F60\u4E5F\u53EF\u4EE5\u4E0ENPC\u5C55\u5F00\u5BF9\u6218\u3002\u7279\u522B\u662F\u5B97\u5E08\u7EA7\u7684NPC\uFF0C\u4ED6\u4EEC\u7684\u5B9E\u529B\u6781\u4E3A\u5F3A\u5927\u3002\r\n\r\n\u4F60\u9700\u8981\u4ECE\u961F\u4F0D\u5185\u76845\u53EA\u5E15\u9C81\u4E2D\u9009\u51FA1\u53EA\u4F5C\u4E3A\u4E3B\u6218\u5E15\u9C81\u4E0E\u4F60\u642D\u6863\u51FA\u6218\uFF0C\u53E6\u5916\u9009\u51FA2\u53EA\u4F5C\u4E3A\u8F85\u52A9\u5E15\u9C81\u5171\u540C\u53C2\u6218\u3002\r\n\u51FB\u8D25\u5BF9\u624B\u5E15\u9C81\u8BAD\u7EC3\u5BB6\u672C\u4EBA\u6216\u5176\u643A\u5E26\u51FA\u6218\u7684\u6240\u6709\u5E15\u9C81\u5373\u53EF\u83B7\u80DC\u3002\r\n\r\n\u6218\u6597\u4E2D\u4F7F\u7528\u7684\u7269\u54C1\u4EE5\u53CA\u5012\u4E0B\u7684\u5E15\u9C81\u4F1A\u5728\u6218\u6597\u7ED3\u675F\u540E\u6062\u590D\u539F\u72B6\u3002\r\n\u203B\u7ADE\u6280\u573A\u5185\u7981\u6B62\u4F7F\u7528\u6D88\u8017\u9053\u5177\r\n\u203B\u7ADE\u6280\u573A\u5185\u7981\u6B62\u4F7F\u7528\u5E15\u9C81\u7403\u6B66\u5668\u548C\u5177\u5907\u589E\u76CA\u6548\u679C\u7684\u6B66\u5668\r\n\r\n\u5728\u6218\u6597\u4E2D\u83B7\u80DC\u53EF\u83B7\u5F97\u6BB5\u4F4D\u70B9\u6570\uFF08RP\uFF09\uFF0C\u7D2F\u79EF\u4E00\u5B9A\u70B9\u6570\u540E\u5373\u53EF\u63D0\u5347\u6BB5\u4F4D\u3002\r\n\u6218\u8D25\u5219\u4F1A\u635F\u5931RP\u3002\r\n\r\n\u9664\u4EB2\u81EA\u53C2\u6218\u5916\uFF0C\u4F60\u8FD8\u53EF\u4EE5\u65C1\u89C2\u5176\u4ED6\u73A9\u5BB6\u4E4B\u95F4\u6B63\u5728\u8FDB\u884C\u7684\u5BF9\u6218\u3002",
    "Help_2_PS5": "\u64CD\u4F5C\u65B9\u6CD5\uFF08\u63A7\u5236\u5668\uFF09\r\n\u5DE6\u64CD\u4F5C\u6746 : \u79FB\u52A8\r\n\u53F3\u64CD\u4F5C\u6746 : \u89C6\u89D2\u64CD\u4F5C\r\n\u003CkeyGuideIcon id=|ThrowPal| OverrideType=|2|/\u003E \u53EC\u5524\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|ThrowObject| OverrideType=|2|/\u003E \u6295\u63B7\u5E15\u9C81\u7403\r\n\u003CkeyGuideIcon id=|OpenConstructionMenu| OverrideType=|2|/\u003E \u5EFA\u7B51\u83DC\u5355\r\n\u003CkeyGuideIcon id=|Jump| OverrideType=|2|/\u003E \u8DF3\u8DC3\r\n\u003CkeyGuideIcon id=|WeaponReady| OverrideType=|2|/\u003E \u7784\u51C6\r\n\u003CkeyGuideIcon id=|WeaponUse| OverrideType=|2|/\u003E \u653B\u51FB\r\n\u003CkeyGuideIcon id=|ReloadAndCoop| OverrideType=|2|/\u003E \u4F19\u4F34\u6280\u80FD\r\n\u003CkeyGuideIcon id=|ChangeWeaponNext| OverrideType=|2|/\u003E \u5207\u6362\u6B66\u5668\r\n\u003CkeyGuideIcon id=|RollingAndCrouch| OverrideType=|2|/\u003E \u4E0B\u8E72/\u7FFB\u6EDA\r\n\u003CkeyGuideIcon id=|DashController| OverrideType=|2|/\u003E \u51B2\u523A\r\n\u003CkeyGuideIcon id=|PartnerPalInstructions| OverrideType=|2|/\u003E \u5E15\u9C81\u6307\u4EE4\r\n\u003CkeyGuideIcon id=|OtomoChangeIncrement| OverrideType=|2|/\u003E\u003CkeyGuideIcon id=|OtomoChangeDecrement| OverrideType=|2|/\u003E \u5207\u6362\u5E15\u9C81\r\n\u003CkeyGuideIcon id=|SphereChange| OverrideType=|2|/\u003E \u5207\u6362\u5E15\u9C81\u7403",
    "Help_43": "\u8DE8\u754C\u5E15\u9C81\u7EC8\u7AEF\r\n\r\n\u5177\u6709\u4FDD\u5B58\u5E15\u9C81\u7EC8\u7AEF\u4E2D\u5E15\u9C81\u7684\u57FA\u56E0\u5E8F\u5217\uFF0C\u4EE5\u53CA\u901A\u8FC7\u57FA\u56E0\u5E8F\u5217\u590D\u539F\u5E15\u9C81\u529F\u80FD\u7684\u8BBE\u65BD\u3002\r\n\u4FDD\u5B58\u7684\u57FA\u56E0\u5E8F\u5217\u53EF\u4EE5\u5E26\u5230\u5176\u4ED6\u4E16\u754C\u4F7F\u7528\u3002\r\n\u4F46\u662F\uFF0C\u540C\u4E00\u4E16\u754C\u5185\u65E0\u6CD5\u540C\u65F6\u5B58\u57282\u53EA\u53CA\u4EE5\u4E0A\u5177\u6709\u76F8\u540C\u57FA\u56E0\u5E8F\u5217\u7684\u5E15\u9C81\u3002\r\n\r\n\u203B\u5982\u679C\u5728\u4E16\u754C\u8BBE\u5B9A\u4E2D\uFF0C\u8BBE\u7F6E\u4E0D\u80FD\u4FDD\u5B58\u548C\u590D\u539F\u5E15\u9C81\u7684\u57FA\u56E0\u5E8F\u5217\u7684\u8BDD\uFF0C\u4E5F\u5C31\u65E0\u6CD5\u8FDB\u884C\u5E15\u9C81\u57FA\u56E0\u5E8F\u5217\u7684\u4FDD\u5B58\u548C\u590D\u539F\u64CD\u4F5C\u3002",
    "Help_44": "\u5982\u679C\u88AB\u5730\u5F62\u5361\u4F4F\u4E86\r\n\r\n\u901A\u8FC7\u9009\u62E9\u83DC\u5355\u4E2D\u300C\u6B7B\u4EA1\u540E\u91CD\u751F\u300D\u9009\u9879\uFF0C\u53EF\u4EE5\u901A\u8FC7\u6B7B\u4EA1\u91CD\u751F\u7684\u65B9\u5F0F\u56DE\u5230\u636E\u70B9\u3002\r\n\u6B64\u5916\uFF0C\u6E38\u620F\u5185\u8FD8\u5B58\u5728\u5373\u4F7F\u4E0D\u901A\u8FC7\u6B7B\u4EA1\u624B\u6BB5\uFF0C\u4E5F\u80FD\u5FEB\u901F\u56DE\u5230\u636E\u70B9\u7684\u9053\u5177\uFF0C\u6216\u8005\u62E5\u6709\u4F20\u9001\u80FD\u529B\u7684\u5E15\u9C81\u3002\r\n\u5C1D\u8BD5\u53BB\u5BFB\u627E\u5B83\u4EEC\u5427\u3002",
    "Help_45": "\u5782\u9493\r\n\r\n\u88C5\u5907\u9493\u7AFF\uFF0C\u5E76\u4ECE\u7269\u54C1\u680F\u4E2D\u9009\u62E9\u9493\u9975\u3002\u5728\u80FD\u770B\u5230\u9C7C\u5F71\u7684\u6C34\u8FB9\u6309\u4F4F\u003CkeyGuideIcon id=|WeaponReady|/\u003E\u67B6\u8D77\u9493\u7AFF\u540E\uFF0C\u6309\u4E0B\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u5373\u53EF\u4E0B\u7AFF\u5F00\u59CB\u5782\u9493\u3002\r\n\u5728\u9A91\u4E58\u5E15\u9C81\u7684\u72B6\u6001\u4E0B\u4E5F\u53EF\u4EE5\u8FDB\u884C\u5782\u9493\u3002\r\n\r\n\u5F53\u5E15\u9C81\u63A5\u8FD1\u9493\u9975\u3001\u6D6E\u6807\u4E0B\u6C89\u65F6\uFF0C\u770B\u51C6\u65F6\u673A\u6309\u4E0B\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u5373\u53EF\u6210\u529F\u56F0\u4F4F\u54AC\u94A9\u7684\u730E\u7269\u3002\r\n\r\n\u56F0\u4F4F\u730E\u7269\u540E\u4F1A\u5F00\u542F\u5C0F\u6E38\u620F\u3002\u8BF7\u5C3D\u91CF\u5C06\u9C7C\u7684\u56FE\u6807\u7EF4\u6301\u5728\u5224\u5B9A\u6761\u5185\u3002\r\n\u6309\u4F4F\u003CkeyGuideIcon id=|WeaponUse|/\u003E\u53EF\u4EE5\u8BA9\u5224\u5B9A\u6761\u5411\u53F3\u79FB\u52A8\uFF0C\u677E\u5F00\u5219\u4F1A\u56DE\u5230\u5DE6\u8FB9\u3002\r\n\u7531\u4E8E\u5E15\u9C81\u4F1A\u6323\u624E\u5E76\u5DE6\u53F3\u79FB\u52A8\uFF0C\u4F60\u9700\u8981\u6839\u636E\u5B83\u7684\u52A8\u5411\u8C03\u6574\u5224\u5B9A\u6761\u7684\u4F4D\u7F6E\uFF0C\u4F7F\u5B83\u4E0E\u5224\u5B9A\u6761\u6301\u7EED\u91CD\u5408\u3002\r\n\r\n\u5224\u5B9A\u6761\u4E0E\u9C7C\u7684\u56FE\u6807\u91CD\u5408\u671F\u95F4\uFF0C\u6355\u83B7\u8BA1\u91CF\u69FD\u4F1A\u9010\u6E10\u7D2F\u79EF\u3002\r\n\u6355\u83B7\u8BA1\u91CF\u69FD\u79EF\u6EE1\u5373\u4E3A\u5782\u9493\u6210\u529F\uFF0C\u53EF\u4EE5\u83B7\u5F97\u5E15\u9C81\u548C\u9053\u5177\u3002\r\n\r\n\u5F3A\u5316\u9493\u7AFF\u6216\u9493\u9975\u53EF\u4EE5\u964D\u4F4E\u5C0F\u6E38\u620F\u7684\u96BE\u5EA6\u3002\r\n\u9493\u4E0A\u7684\u730E\u7269\u8D8A\u5927\uFF0C\u6D88\u8017\u9493\u7AFF\u7684\u8010\u4E45\u5EA6\u5C31\u8D8A\u591A\u3002\r\n\u5982\u679C\u89C9\u5F97\u5782\u9493\u592A\u96BE\uFF0C\u4E0D\u59A8\u8BD5\u7740\u5236\u4F5C\u6027\u80FD\u66F4\u9AD8\u7684\u9493\u7AFF\u6216\u9493\u9975\uFF0C\u91CD\u65B0\u8FDB\u884C\u6311\u6218\u3002\r\n\u6B64\u5916\uFF0C\u90E8\u5206\u5E15\u9C81\u53EF\u4EE5\u534F\u52A9\u73A9\u5BB6\u8FDB\u884C\u5782\u9493\uFF0C\u8BB0\u5F97\u53BB\u627E\u627E\u770B\u5427\u3002"
  }
}