    "SpawnPoint_1": "\u5728\u4E00\u4E2A\u5C0F\u5C71\u4E18\u4E0A\u3002\r\n\u4E0D\u4EC5\u89C6\u91CE\u5F00\u9614\uFF0C\u8D44\u6E90\u4E5F\u6781\u5176\u4E30\u5BCC\uFF0C\r\n\u975E\u5E38\u9002\u5408\u7B2C\u4E00\u6B21\u6E38\u73A9\u7684\u65B0\u624B\u3002",
